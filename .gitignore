!.claude/
.claude/__pycache__/
.claude/.credentials.json
!.gemini/
!.codex/
.gemini/__pycache__/
.codex/__pycache__/
.perplexity/
.mcp.json

# ---- LARGE BINARIES ----
*.mp4
*.mp3
*.wav
*.avi
*.mkv
*.mov
*.zip
*.tar.gz
*.tar.bz2
*.7z
*.rar
*.apk
*.pdf
*.iso
*.dmg

# ---- PROTON / CLOUD MOUNT ARTIFACTS ----
ProtonDrive/

# ---- HIVE DOCTRINE COMPILER OUTPUTS (regenerated by sync) ----
# Source of truth: .claude/{agents,skills} + plugin marketplace + LUCREX.md
# Outputs (mirrors): regenerated hourly by hive_sync_v2.sh
.gemini/agents/
.gemini/skills/
.gemini/commands/
.codex/agents/
.codex/skills/
.codex/commands/

# Cloud-state local mirror (per feedback_cloud_state_mirrors_local_always)
_state/cloud_mirror_secrets/

# Pre-migration archives of obsolete function bodies (local reference only)
*.pre-migration.*.txt
03_AUTOMATION_CORE/03_Credentials/polymarket_wallet.*
