# XLM Bot Environment Variables
# Copy to .env and fill in values

# Coinbase API config (JSON with api_key + api_secret)
# Default: auto-detected from vendor/ directory
COINBASE_CONFIG_PATH=/app/secrets/config.json

# Slack webhook URL for trade alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Bot config file (default: config.yaml)
XLM_CONFIG_FILE=config.yaml

# Timezone
TZ=America/Los_Angeles

# AI Executive Mode (Hive Mind on cloud)
# Required for Claude Opus executive mode without interactive session
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional: Gemini peer advisor (omit to disable Gemini on cloud)
GEMINI_API_KEY=AIzaSy...
