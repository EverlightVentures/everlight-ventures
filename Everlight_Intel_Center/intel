def header(text: str, n: int | None = None) -> None:
    suffix = f" ({n})" if n is not None else ""
    print(f"\n{GOLD}{BOLD}== {text}{suffix} =={RESET}")


def fmt_row(domain: str, category: str, purpose: str, agent: str = "", status: str = "") -> str:
    purpose = (purpose or "")[:65]
    badge = ""
    if status == "checked":
        badge = f" {GREEN}[curated]{RESET}"
    elif status == "auto":
        badge = f" {DIM}[auto]{RESET}"
    elif status == "unverified":
        badge = f" {RED}[review]{RESET}"
    return f"  {GOLD}{domain:<30}{RESET} {DIM}|{RESET} {category:<26} {DIM}|{RESET} {purpose}{badge}"


def open_db() -> sqlite3.Connection:
    if not DB.exists():
        sys.exit(f"{RED}Database missing at {DB} -- run `intel rebuild-full` first.{RESET}")
    return sqlite3.connect(DB)


def cmd_dash(args: list[str]) -> None:
    """Start the Intel dashboard on port 2300. Forwards args to serve.sh."""
    serve = ROOT / "09_Dashboard" / "serve.sh"
    if serve.exists():
        subprocess.run(["bash", str(serve), *args])
        return
    # Fallback: open the static HTML report
    if not HTML.exists():
        sys.exit(f"{RED}HTML report missing at {HTML} -- run `intel rebuild`.{RESET}")
    print(f"{GOLD}Intel dashboard (static fallback):{RESET} file://{HTML}")
    for opener in ("xdg-open", "termux-open-url", "termux-open", "open"):
        if shutil.which(opener):
            subprocess.Popen([opener, str(HTML)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            break


def cmd_search(args: list[str]) -> None:
    """Full-text-ish search across domain + purpose + raw_text + tags + notes."""
    if not args:
        sys.exit("usage: intel search <query>")
    q = " ".join(args).strip()
    con = open_db()
    needle = f"%{q}%"
    rows = con.execute("""
        SELECT domain, category, purpose, agent_owner, verified_status
        FROM resources
        WHERE domain LIKE ? OR purpose LIKE ? OR raw_text LIKE ? OR tags LIKE ? OR notes LIKE ?
        ORDER BY (verified_status='checked') DESC, category, domain
        LIMIT 60
    """, (needle,) * 5).fetchall()
    header(f"search '{q}'", len(rows))
    if not rows:
        print(f"  {DIM}no matches -- try a broader term or `intel cat <category>`{RESET}")
        return
    for d, c, p, a, s in rows:
        print(fmt_row(d, c, p, a, s))


def cmd_cat(args: list[str]) -> None:
    """List resources in a category. Substring match against category name."""
    if not args:
        # Show category list if no arg
        con = open_db()
        cats = con.execute("SELECT category, COUNT(*) FROM resources GROUP BY category ORDER BY 2 DESC").fetchall()
        header("categories", len(cats))
        for c, n in cats:
            print(f"  {n:>4}  {GOLD}{c}{RESET}")
        print(f"\n{DIM}Use: intel cat <name-substring>{RESET}")
        return
    q = " ".join(args).lower()
    con = open_db()
    cats = [c for (c,) in con.execute("SELECT DISTINCT category FROM resources").fetchall()
            if q in c.lower()]
    if not cats:
        sys.exit(f"{RED}No category matches '{q}'. Try: intel cat (no args) for the full list.{RESET}")
    for cat in cats:
        rows = con.execute("""
            SELECT domain, category, purpose, agent_owner, verified_status
            FROM resources WHERE category=?
            ORDER BY (verified_status='checked') DESC, domain
        """, (cat,)).fetchall()
        header(cat, len(rows))
        for d, c, p, a, s in rows:
            print(fmt_row(d, c, p, a, s))


def cmd_agent(args: list[str]) -> None:
    """Resources owned by an agent (substring match)."""
    if not args:
        con = open_db()
        agents = con.execute("SELECT agent_owner, COUNT(*) FROM resources GROUP BY agent_owner ORDER BY 2 DESC").fetchall()
        header("agents", len(agents))
        for a, n in agents:
            print(f"  {n:>4}  {GOLD}{a}{RESET}")
        return
    q = " ".join(args).lower()
    con = open_db()
    rows = con.execute("""
        SELECT domain, category, purpose, agent_owner, verified_status
        FROM resources WHERE LOWER(agent_owner) LIKE ?
        ORDER BY category, domain
    """, (f"%{q}%",)).fetchall()
    header(f"agent '{q}'", len(rows))
    for d, c, p, a, s in rows:
        print(fmt_row(d, c, p, a, s))


