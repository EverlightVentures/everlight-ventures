# Everlight Ventures -- agent secrets template
# Copy to ~/.config/everlight/secrets.env on each host, fill in values,
# then `chmod 600 ~/.config/everlight/secrets.env`.
#
# Why this file is .example and committed: it documents the EXPECTED keys
# without leaking values. The actual values live in chmod 600 files outside
# git, sourced by cron entries via POSIX dot syntax:
#   . /root/.config/everlight/secrets.env   (phone)
#   . /home/opc/.config/everlight/secrets.env   (Oracle)
#
# Each line must use `export` so vars propagate to child processes (python3)
# under /bin/sh (default cron shell).

# Gmail IMAP -- inbox watch / reply parsing
export IMAP_USER=
export IMAP_PASS=

# Resend -- outbound transactional email (used by branded_mailer)
export RESEND_API_KEY=

# Slack -- bot posts to #hive-alerts, #broker-pipeline, etc.
export SLACK_BOT_TOKEN=

# Slack webhook for cron-redundancy alerts (separate channel, optional)
export SLACK_HIVE_ALERTS_WEBHOOK=

# Eradication lockout -- propagates the halt flag to every cron child process.
# Set to 1 to halt all wholesale outbound. Lift only on operator greenlight.
export WHOLESALE_OUTBOUND_HALT=1
export ERADICATION_GATE_REQUIRED=1

# Cron-redundancy role:
#   primary    = this host is the canonical cron runner (phone)
#   secondary  = defer to peer heartbeat; only run if peer is stale (Oracle)
export WHOLESALE_REDUNDANCY_ROLE=primary
