# Per-state appendix file mapping. ANY state-with-active-distress-deal MUST have
# a row here or contract generation is blocked. CA = CC 1695 (misdemeanor + $25k
# + treble damages if missing). OH = ORC 1349.61 + 4735.02 unauthorized practice.
STATE_APPENDIX_FILES = {
    "CA": "CA_1695_APPENDIX.md",
    "OH": "OH_DISCLOSURE_APPENDIX.md",
}

APPENDIX_SEPARATOR = (
    "\n\n---\n\n"
    "## STATE-SPECIFIC DISCLOSURE APPENDIX\n\n"
)


def _load_state_appendix(state: str) -> str | None:
    """Return the markdown content of the state-specific disclosure appendix.

    Maps a 2-letter state code (e.g. "CA", "OH") to the appropriate appendix
    file under one of the COMPLIANCE_DIRS. Returns None if there is no
    appendix mapping for the state. Returns None and logs a warning if the
    mapping exists but the file is missing on disk; callers MUST treat that
    as a hard block (no contract should ship without disclosures the law
    requires for a homeowner in distress in that state).
    """
    if not state:
        return None
    code = state.strip().upper()
    fname = STATE_APPENDIX_FILES.get(code)
    if not fname:
        return None
    for base in COMPLIANCE_DIRS:
        candidate = base / fname
        if candidate.exists():
            try:
                return candidate.read_text(encoding="utf-8")
            except Exception as exc:
                log.warning(f"failed to read appendix {candidate}: {exc}")
                return None
    log.warning(f"appendix file {fname} mapped for {code} but not found in any COMPLIANCE_DIRS")
    return None


def _state_requires_appendix(state: str) -> bool:
    """True if the lead's state has a known disclosure regime we enforce."""
    if not state:
        return False
    return state.strip().upper() in STATE_APPENDIX_FILES

