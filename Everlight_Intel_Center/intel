    for cat, total, used in rows:
        pct = used * 100 // max(total, 1)
        bar = "█" * (pct // 5) + DIM + "░" * (20 - pct // 5) + RESET
        print(f"  {cat:<30} {used:>5} / {total:>5}  {pct:>4}%  {bar}")

    # Per-agent: who has resources but isn't using them?
    header("usage by agent owner")
    rows = con.execute("""
        SELECT r.agent_owner,
               COUNT(*) AS total,
               SUM(COALESCE(a.in_use, 0)) AS used
        FROM resources r LEFT JOIN audit a ON r.domain = a.domain
        GROUP BY r.agent_owner
        ORDER BY total DESC
    """).fetchall()
    for agent, total, used in rows:
        gap = total - used
        flag = f" {RED}({gap} unused){RESET}" if gap > total // 2 else ""
        print(f"  {used:>3} / {total:>3}  {GOLD}{agent}{RESET}{flag}")

    # In-use resources with their evidence
    header("currently-in-use resources")
    rows = con.execute("""
        SELECT r.domain, r.category, r.agent_owner, a.evidence
        FROM resources r JOIN audit a ON r.domain = a.domain
        WHERE a.in_use = 1
