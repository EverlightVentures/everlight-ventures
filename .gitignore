*.pre-migration.*.txt
03_AUTOMATION_CORE/03_Credentials/polymarket_wallet.*

# ============================================================
# 2026-05-29 AUTO-SYNC SAFETY HARDENING
# Close secret + noise gaps before the AceMagician catch-up / auto-sync.
# (An automatic commit must never leak a credential or churn runtime state.)
# ============================================================

# ---- SECRET GAPS (the existing patterns were almost-right) ----
# Suffixed env backups: .env.bak.preplymkt, .env.bak.20260503-2131, .env.bak.1778944697
**/*.env.bak*
**/.env.bak*
# rclone crypt recovery key + any recovery/key text dropped in Credentials
03_AUTOMATION_CORE/03_Credentials/RCLONE_CRYPT_RECOVERY.txt
03_AUTOMATION_CORE/03_Credentials/*RECOVERY*
03_AUTOMATION_CORE/03_Credentials/*.key
03_AUTOMATION_CORE/03_Credentials/*.pem
# The cloud-state mirror itself (doctrine: holds secrets, chmod 600). The old
# rule only matched _state/cloud_mirror_secrets/ -- the real dir has no suffix.
_state/cloud_mirror/

# ---- CRYPTO WALLET SECRETS (added 2026-06-02) ----
# chmod does NOT stick on the sdcard FUSE mount (600 -> 660), so file perms are
# not real protection. These MUST stay untracked and move into Proton Pass.
03_AUTOMATION_CORE/03_Credentials/proton_pass_import.*
03_AUTOMATION_CORE/03_Credentials/SEED_VAULT*
**/atomic_sp.py
**/phantom_sp.py
**/bcardi_coin_sp.py
**/Zilpay_Bacardi_Wallet_SP.py
**/seed_phrase_phantom.py

# ---- RUNTIME STATE / DBs (churns every cycle, not source) ----
_state/blinko_lite.db
_state/blinko_lite.db-shm
_state/blinko_lite.db-wal
_state/agentmemory_graph.json
*.sqlite
**/*.db-wal
**/*.db-shm
*.pid
*.status
.claude/scheduled_tasks.lock
_state/*.tmp_*
.claude/.sync_conflicts/

# ---- GENERATED REPORTS / CACHES (regenerated, not source) ----
09_DASHBOARD/reports/*.html
09_DASHBOARD/reports/daily_leads/*.html
06_DEVELOPMENT/everlight_os/intel_center/cache/

# DeHashed-enriched PII output (regenerable, breach-sourced -- keep out of git)
01_BUSINESSES/Everlight_Ventures/Wholesale/config/_generated/

# MMA medical/sanctioning paperwork -- PII, never commit, never serve
05_PERSONAL/02_Training/MMA_Notebook/MMA_Paperwork/

# Big binaries (GH001 100MB limit) -- installers + voice models stay on disk only
*.AppImage
FirefoxSetup.exe
06_DEVELOPMENT/everlight_os/voice/models/*.bin

# ============================================================
# 2026-07-28 SELECTIVE-COMMIT PASS HARDENING
# Cleared a stale .git/index.lock (dated 2026-07-14) that had been silently
# failing every commit for 16 days. 2,201 files had piled up. These rules
# separate generated output from source so the backlog cannot re-form.
# ============================================================

# ---- SECRET GAP: the existing *_secret* / *_key.txt patterns miss this ----
# `.secret_key` has a dot before "secret", so no prior rule matched it.
**/.secret_key

# ---- GENERATED REPORTS (only *.html was ignored; the rest churn daily) ----
# ~51 auto-generated reports/day. Regenerated by cron, never hand-edited.
09_DASHBOARD/reports/*.md
09_DASHBOARD/reports/*.json
09_DASHBOARD/reports/*.png
09_DASHBOARD/reports/gdocs_queue/
# Nested copies of the same queue under business dirs
**/09_DASHBOARD/reports/gdocs_queue/

# ---- RUNTIME PIPELINE OUTPUT (daily files, mostly empty arrays) ----
01_BUSINESSES/Everlight_Ventures/Broker_OS/wholesale_agent/pipeline/*_leads.json
**/failed_emails/

# ---- MOLTBOOK RUNTIME LEARNINGS (regenerated by the engagement loop) ----
_state/moltbook/lucrex_learnings/

# ---- SUPABASE CLI TEMP ----
supabase/.temp/

# ---- ALLEY KINGZ BINARY ASSET TREES (2026-07-28) ----
# Discovered during the selective-commit pass: these untracked dirs total
# ~1.5GB. A blind `git add` on the AK ecosystem would have tried to commit
# all of it and failed GitHub's 100MB ceiling. Per the header of this file,
# GitHub is logic/code/docs only; assets live on Nextcloud + e5.
**/e5_art_backup/
**/_bg_backup/
**/_arttest/
**/_ak_rollback_local/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/story/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/models/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/icons/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/sprites/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/portraits/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/avatar/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/bosses/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/vendor/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/cosmetics/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/interiors/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/game/assets/hub/
01_BUSINESSES/Everlight_Ventures/Alley_Kingz/ecosystem/_state/

# ---- EMBEDDED GIT REPO (2026-07-28) ----
# trading_agents has its own .git. Adding it as a plain path creates a
# broken gitlink that clones as an empty dir. Track it as a real submodule
# if it should live here, otherwise it stays independent.
06_DEVELOPMENT/trading_agents/
# Suffixed backups: *.bak.20260426_101356 etc (plain *.bak missed these)
*.bak.*

# ---- MOLTBOOK AGENT KEYS (2026-07-28) -- LIVE SECRETS ----
# Contains moltbook_sk_* secret keys, moltbook_claim_* tokens and 7 api_key
# fields. Was TRACKED, so these values are already in git history and must
# be treated as compromised until rotated. Untracked here to stop further
# exposure; history rewrite + rotation is a separate operator decision.
_state/moltbook/agent_keys.jsonl

# ---- RUNTIME STATE (churns constantly, not source) ----
_state/heartbeats/
_state/moltbook/*_seen.json
_state/moltbook/notifier_state.json
_state/moltbook/.migrated_to_e5
_state/sync_conflicts.jsonl
