def cmd_pull(args: list[str]) -> None:
    if not args:
        sys.exit("usage: intel pull <domain>")
    domain = args[0].strip().lower().rstrip("/")
    for p in ("https://", "http://"):
        if domain.startswith(p):
            domain = domain[len(p):]
    print(f"{GOLD}Pulling {domain} ...{RESET}")
    result = _pull_one(domain)
    inserted = _ensure_resource_row(domain, result)
    if inserted:
        print(f"  {DIM}+ inserted as new resource row -- it now appears in the dashboard.{RESET}")
    # Cache: per-domain JSON + master SQLite
    safe = re.sub(r"[^a-z0-9]+", "_", domain).strip("_")
    ARTICLES_DIR.mkdir(parents=True, exist_ok=True)
    (ARTICLES_DIR / f"{safe}.json").write_text(json.dumps(result, indent=2))
    con = _articles_db()
    now = result["fetched_at"]
    inserted = 0
    for it in result["items"]:
        try:
            con.execute(
                "INSERT OR IGNORE INTO articles (domain, title, url, published, summary, fetched_at) VALUES (?,?,?,?,?,?)",
                (domain, it["title"], it["url"], it["published"], it["summary"], now)
            )
            inserted += con.total_changes
        except sqlite3.Error:
            pass
    con.commit(); con.close()
    header(f"{domain} -- {result['method']}{(' ' + result['rss_path']) if result['rss_path'] else ''}", len(result["items"]))
    if not result["items"]:
        print(f"  {RED}no items found -- source may be JS-rendered or behind auth{RESET}")
        return
    for i, it in enumerate(result["items"][:12], 1):
        print(f"  {GOLD}{i:>2}.{RESET} {BOLD}{it['title'][:90]}{RESET}")
        if it["published"]:
            print(f"      {DIM}{it['published'][:60]}{RESET}")
        if it["summary"]:
            print(f"      {DIM}{it['summary'][:140]}{RESET}")
        if it["url"]:
            print(f"      {CYAN}{it['url'][:90]}{RESET}")
        print()
    print(f"{DIM}cached -> cache/articles/{safe}.json + cache/articles.sqlite ({inserted} new in DB){RESET}")


def cmd_pull_all(args: list[str]) -> None:
    if not args:
        sys.exit("usage: intel pull-all <category-substring>  (e.g. news, weather, space)")
    q = " ".join(args).lower()
    con = open_db()
    cats = [c for (c,) in con.execute("SELECT DISTINCT category FROM resources").fetchall() if q in c.lower()]
    if not cats:
        sys.exit(f"{RED}No category matches '{q}'.{RESET}")
    for cat in cats:
        domains = [d for (d,) in con.execute(
            "SELECT domain FROM resources WHERE category=? AND domain != ''", (cat,)
        ).fetchall()]
        header(f"pull-all '{cat}'", len(domains))
        import concurrent.futures as cf
        ok_with_items = 0; total_items = 0
        with cf.ThreadPoolExecutor(max_workers=6) as ex:
            futures = {ex.submit(_pull_one, d): d for d in domains}
            artcon = _articles_db()
            now = datetime.now().isoformat()
            for fut in cf.as_completed(futures):
                d = futures[fut]
                try:
                    res = fut.result()
                except Exception:
                    res = {"domain": d, "items": [], "method": "error", "rss_path": "", "fetched_at": now}
                # Save per-domain
                safe = re.sub(r"[^a-z0-9]+", "_", d).strip("_")
                ARTICLES_DIR.mkdir(parents=True, exist_ok=True)
                (ARTICLES_DIR / f"{safe}.json").write_text(json.dumps(res, indent=2))
                # Save to master DB
                for it in res["items"]:
                    try:
                        artcon.execute(
                            "INSERT OR IGNORE INTO articles (domain, title, url, published, summary, fetched_at) VALUES (?,?,?,?,?,?)",
                            (d, it["title"], it["url"], it["published"], it["summary"], now)
                        )
                    except sqlite3.Error:
                        pass
                if res["items"]:
                    _ensure_resource_row(d, res)
                    ok_with_items += 1; total_items += len(res["items"])
                    print(f"  {GREEN}✓{RESET} {GOLD}{d:<30}{RESET} {len(res['items']):>2} items ({res['method']})")
                else:
                    print(f"  {RED}✗{RESET} {DIM}{d:<30} no items ({res['method']}){RESET}")
            artcon.commit(); artcon.close()
        print(f"\n{GOLD}Done: {ok_with_items}/{len(domains)} sources returned items, {total_items} total cached.{RESET}")


