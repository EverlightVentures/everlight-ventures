# Everlight Hive Mind SaaS - Environment Variables
# Copy to .env and fill in all values before starting

# App
ENVIRONMENT=development
DEBUG=false
WORKSPACE_ROOT=/mnt/sdcard/AA_MY_DRIVE

# Database
DATABASE_URL=sqlite+aiosqlite:///./runtime/hivemind.db
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Auth
JWT_SECRET=generate_a_long_random_secret_here
JWT_EXPIRE_MINUTES=10080
ALLOW_SIGNUP=true
BOOTSTRAP_EMAIL=admin@local.hive
BOOTSTRAP_PASSWORD=ChangeMe123!

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SPARK=price_...
STRIPE_PRICE_HIVE=price_...
STRIPE_PRICE_ENTERPRISE=price_...
BILLING_BASE_URL=https://app.everlight.ai/settings/billing
FRONTEND_URL=http://localhost:3000

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_AUDIT_CHANNEL=#hive-audit
SLACK_ALERTS_CHANNEL=#hive-alerts
SLACK_SALES_CHANNEL=#hive-sales

# Platform AI Keys (for running the hive)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# Encryption (for storing tenant API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=["http://localhost:3000","https://app.everlight.ai"]
