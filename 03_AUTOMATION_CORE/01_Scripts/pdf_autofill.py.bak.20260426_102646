def deal_to_context(deal: Deal) -> dict[str, str]:
    """Build the substitution dict from a Deal + its related rows."""
    ctx = dict(ASSIGNOR_BLOCK)

    lead = getattr(deal, "lead", None)
    addr = ""
    seller_name = ""
    seller_email = ""
    seller_phone = ""
    seller_address = ""
    state = ""
    county = ""
    if lead:
        addr = getattr(lead, "address", "") or ""
        seller_name = getattr(lead, "name", "") or ""
        seller_email = getattr(lead, "email", "") or ""
        seller_phone = getattr(lead, "phone", "") or ""
        seller_address = addr
        state = (getattr(lead, "state", "") or "").upper()
        county = getattr(lead, "county", "") or ""

    ctx.update({
        "DATE": datetime.now(timezone.utc).strftime("%B %d, %Y"),
        "PROPERTY_ADDRESS": addr or "[ADDRESS PENDING]",
        "STATE": state or "[STATE PENDING]",
        "COUNTY": county or "[COUNTY PENDING -- pull from county assessor]",
        "LEGAL_DESCRIPTION": "See attached Exhibit A; legal description as recorded in the official records of the county clerk.",
        "SELLER_NAME": seller_name or "[SELLER NAME PENDING]",
        "SELLER_ADDRESS": seller_address or "[SELLER ADDRESS PENDING]",
        # Assignee (buyer) defaults to TBD until Rex matches a buyer
        "ASSIGNEE_NAME": "[ASSIGNEE NAME -- to be filled at buyer match]",
        "ASSIGNEE_ADDRESS": "[ASSIGNEE ADDRESS -- to be filled at buyer match]",
        "ASSIGNEE_PHONE": "[ASSIGNEE PHONE]",
        "ASSIGNEE_EMAIL": "[ASSIGNEE EMAIL]",
        "ORIGINAL_CONTRACT_DATE": datetime.now(timezone.utc).strftime("%B %d, %Y"),
        "ASSIGNMENT_FEE": _fmt_money(getattr(deal, "deal_value", None)),
        "DEPOSIT_AMOUNT": _fmt_money(_pct(getattr(deal, "deal_value", None), 0.10)),
        "BALANCE_AMOUNT": _fmt_money(_pct(getattr(deal, "deal_value", None), 0.90)),
        "EMD_AMOUNT": _fmt_money(getattr(deal, "earnest_money_deposit", None) or _pct(getattr(deal, "deal_value", None), 0.05)),
        "ESCROW_HOLDER": getattr(deal, "title_company", "") or "[TITLE COMPANY -- pull from /Wholesale/title_companies/SHORTLIST.md]",
        "STATE_EMD_RULES": STATE_EMD_RULES.get(state, STATE_EMD_DEFAULT),
    })
    return ctx


def _pct(value, pct: float) -> Decimal | None:
    if value in (None, ""):
        return None
    try:
        return (Decimal(str(value)) * Decimal(str(pct))).quantize(Decimal("0.01"))
    except Exception:
        return None


def _fmt_money(v) -> str:
    if v in (None, "", 0, Decimal("0"), "0", "0.00"):
        return "[AMOUNT PENDING]"
    try:
        return f"{Decimal(str(v)):,.2f}"
    except Exception:
        return str(v)


def render(template: str, ctx: dict[str, str], dry_run: bool = False) -> tuple[str, list[str]]:
    """Substitute [TOKEN] placeholders. Returns (filled_text, unmapped_tokens)."""
    filled = template
    for key, val in ctx.items():
        filled = filled.replace(f"[{key}]", str(val))
    unmapped = sorted(set(re.findall(r"\[([A-Z_][A-Z0-9_]*)\]", filled)))
    if dry_run and unmapped:
        log.info(f"unmapped tokens: {unmapped}")
    return filled, unmapped


def md_to_html(md: str) -> str:
    """Render markdown to a styled HTML page."""
    try:
        import markdown as md_lib
        body = md_lib.markdown(md, extensions=["extra"])
    except ImportError:
        # Bare-minimum fallback: pre-formatted text in a code block.
        body = "<pre>" + md.replace("<", "&lt;").replace(">", "&gt;") + "</pre>"
    return _HTML_SHELL.replace("{{BODY}}", body)


def md_to_pdf(md: str, out_path: Path) -> bool:
    """Render markdown to PDF via fpdf2. Returns True on success."""
    try:
        from fpdf import FPDF
    except ImportError:
        log.warning("fpdf2 not installed, skipping PDF output")
        return False

    pdf = FPDF()
    pdf.add_page()
    pdf.set_auto_page_break(auto=True, margin=15)
    pdf.set_font("Helvetica", size=10)
    for line in md.split("\n"):
        # Skip table separator lines
        if re.match(r"^[-=_]{3,}$", line.strip()):
            pdf.ln(2)
            continue
        # Light header detection
        if line.startswith("# "):
            pdf.set_font("Helvetica", "B", 14)
            pdf.cell(0, 8, line[2:], new_x="LMARGIN", new_y="NEXT")
            pdf.set_font("Helvetica", size=10)
        elif line.startswith("## "):
            pdf.set_font("Helvetica", "B", 12)
            pdf.cell(0, 7, line[3:], new_x="LMARGIN", new_y="NEXT")
            pdf.set_font("Helvetica", size=10)
        elif line.startswith("### "):
            pdf.set_font("Helvetica", "B", 11)
            pdf.cell(0, 6, line[4:], new_x="LMARGIN", new_y="NEXT")
            pdf.set_font("Helvetica", size=10)
        else:
            try:
                pdf.multi_cell(0, 5, line.encode("latin-1", "replace").decode("latin-1"))
            except Exception:
                pdf.multi_cell(0, 5, "")
    pdf.output(str(out_path))
    return True


def maybe_send_to_documenso(deal: Deal | None, pdf_path: Path) -> str | None:
    """Submit the filled PDF to self-hosted Documenso for e-sign.

    Documenso runs on Oracle at https://sign.everlightventures.io. Open-source,
    ESIGN/UETA compliant, recognized by title companies. Replaces HelloSign.

    Auth: DOCUMENSO_API_URL (default https://sign.everlightventures.io/api/v1)
          DOCUMENSO_API_KEY (Bearer token from /settings/tokens). Until the
          token is set, this gracefully no-ops.

    Flow:
      1. POST /documents to create the document shell
      2. PUT the PDF bytes to the returned uploadUrl
      3. POST /documents/{id}/send-for-signing to email the signer
      4. Update Deal.agreement_url with the public signing URL
    """
    api_url = os.environ.get(
        "DOCUMENSO_API_URL",
        "https://sign.everlightventures.io/api/v1",
    ).rstrip("/")
    api_key = os.environ.get("DOCUMENSO_API_KEY", "")
    if not api_key:
        log.info("DOCUMENSO_API_KEY not set; skipping e-sign send (PDF still saved locally)")
        return None
    if not pdf_path.exists():
        log.warning("PDF missing, cannot send to Documenso")
        return None
    if deal is None or getattr(deal, "lead", None) is None:
        log.warning("deal/lead missing, cannot determine signer; skipping")
        return None

    lead = deal.lead
    seller_email = (getattr(lead, "owner_email", "") or "").strip()
    seller_name = (getattr(lead, "owner_name", "") or "").strip() or "Seller"
    if not seller_email:
        log.warning(f"lead {lead.id} has no owner_email; cannot send for signature")
        return None

    title = f"Assignment Agreement -- {getattr(lead, 'address', deal.id)}"

    try:
        # Step 1: create document with one recipient (the seller)
        create_payload = {
            "title": title,
            "recipients": [
                {"email": seller_email, "name": seller_name, "role": "SIGNER"},
            ],
            "meta": {
                "subject": f"Sign your assignment agreement for {getattr(lead, 'address', '')}",
                "message": (
                    "Per our conversation, please review and sign the assignment "
                    "agreement. The contract is contingent on inspection and your "
                    "EMD is held by an escrow company until close. Reach out with "
                    "any questions."
                ),
            },
        }
        req = urllib.request.Request(
            f"{api_url}/documents",
            data=json.dumps(create_payload).encode("utf-8"),
            headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json",
            },
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            doc = json.loads(resp.read().decode("utf-8"))
        doc_id = doc.get("id") or (doc.get("document") or {}).get("id")
        upload_url = doc.get("uploadUrl") or doc.get("upload_url")
        if not doc_id or not upload_url:
            log.warning(f"Documenso create did not return id+uploadUrl: {doc}")
            return None

        # Step 2: PUT the PDF bytes to the upload URL (S3-style presigned)
        with pdf_path.open("rb") as f:
            put_req = urllib.request.Request(
                upload_url,
                data=f.read(),
                headers={"Content-Type": "application/pdf"},
                method="PUT",
            )
            urllib.request.urlopen(put_req, timeout=60).read()

        # Step 3: send for signature
        send_req = urllib.request.Request(
            f"{api_url}/documents/{doc_id}/send-for-signing",
            data=b"{}",
            headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json",
            },
            method="POST",
        )
        urllib.request.urlopen(send_req, timeout=30).read()

        signing_url = f"https://sign.everlightventures.io/sign/{doc_id}"
        log.info(f"Documenso document {doc_id} sent to {seller_email}")

        # Update Deal.agreement_url so the dashboard reflects it
        try:
            if hasattr(deal, "agreement_url"):
                deal.agreement_url = signing_url
                deal.save(update_fields=["agreement_url"])
        except Exception as exc:
            log.warning(f"could not save agreement_url: {exc}")

        return signing_url

    except urllib.error.HTTPError as exc:
        body = ""
        try:
            body = exc.read().decode("utf-8", "replace")[:300]
        except Exception:
            pass
        log.warning(f"Documenso HTTP {exc.code}: {body}")
        return None
    except Exception as exc:
        log.warning(f"Documenso send error: {exc}")
        return None


