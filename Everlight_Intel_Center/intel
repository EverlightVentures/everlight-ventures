        print(f"      events for this deal: {len(events_for_deal)}")
        if events_for_deal:
            print(f"      first event id: {events_for_deal[0]['id']}, last: {events_for_deal[-1]['id']}")

    elif sub == "fire":
        if len(args) < 3:
            print(f"usage: intel deal fire <deal_key> <step>")
            print(f"  steps: {list(ARC_FUNCTIONS.keys())}"); return
        key, step = args[1], args[2]
        kwargs = {}
        # Allow `intel deal fire X m5_meet 12000` to pass counter_amount
        if len(args) >= 4 and step == "m5_meet":
            try: kwargs["counter_amount"] = int(args[3])
            except ValueError: pass
        result = fire_step(key, step, **kwargs)
        print(_json.dumps(result, indent=2))

    elif sub == "new":
        if len(args) < 2:
            print("usage: intel deal new <deal_key> [--test]"); return
        key = args[1]
        test_mode = "--test" in args
        meta = load_deal_meta(key)  # gets defaults for 1536 S Third
        meta["deal_key"] = key
        meta["test_mode"] = test_mode
        if test_mode:
            # Test-mode: redirect everything to operator inbox by setting recipient = operator
            print(f"  test_mode=True: all sends redirect to operator inbox (1m.rich.gee@gmail.com)")
        write_deal_meta(key, meta)
        print(f"  ✓ wrote deal_meta.json for {key}")
        # AUTO-RENDER the 5 contract HTMLs + index from deal_meta. Eliminates the
