def _articles_db():
    ARTICLES_DB.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(ARTICLES_DB)
    con.execute("""
        CREATE TABLE IF NOT EXISTS articles (
            id INTEGER PRIMARY KEY,
            domain TEXT,
            title TEXT,
            url TEXT,
            published TEXT,
            summary TEXT,
            fetched_at TEXT,
            UNIQUE(domain, url)
        )
    """)
    con.execute("CREATE INDEX IF NOT EXISTS idx_a_domain ON articles(domain)")
    con.execute("CREATE INDEX IF NOT EXISTS idx_a_fetched ON articles(fetched_at)")
    return con


def _try_curl(url: str, timeout: int = 8, log_domain: str | None = None) -> str:
    """Curl with auto live_log instrumentation. log_domain enables success/failure tracking."""
    domain = log_domain
    if not domain:
        m = re.match(r"https?://([^/]+)", url)
        if m: domain = m.group(1)
    status = 0
    bytes_received = 0
    err = None
    text = ""
    try:
        r = subprocess.run(
            ["curl", "-sL", "--max-time", str(timeout), "--max-filesize", "1500000",
             "-A", "Mozilla/5.0 (compatible; EverlightIntel/1.0)",
             "-w", "%{http_code}|%{size_download}", "-o", "-", url],
            capture_output=True, text=True, timeout=timeout + 2,
        )
        if r.returncode == 0 and r.stdout:
            # Last line of stdout is "code|bytes" (because -w writes after body)
            body, _, tail = r.stdout.rpartition("\n")
            if "|" in tail:
                code_s, _, bytes_s = tail.partition("|")
                try:
                    status = int(code_s.strip())
                    bytes_received = int(bytes_s.strip())
                except ValueError:
                    status = 200 if body else 0
                text = body
            else:
                # No trailing -w (older curl?), assume success based on output
                status = 200 if r.stdout else 0
                text = r.stdout
        else:
            err = f"curl rc={r.returncode}"
    except subprocess.TimeoutExpired:
        err = "timeout"
    # Record to live_log
    if domain:
        try:
            from osint_api import live_log
            live_log.record(domain, status_code=status, bytes_received=bytes_received,
                           method="GET", error=err)
        except Exception:
            pass  # Never let logging break the fetch
    return text


def _parse_rss(xml_text: str) -> list[dict]:
    """Lightweight RSS/Atom parser using stdlib. Handles namespaced docs."""
    import xml.etree.ElementTree as ET
    items: list[dict] = []
    if not xml_text or len(xml_text) < 50:
        return items
    try:
        xml_text = xml_text.lstrip("﻿").strip()
        root = ET.fromstring(xml_text)
    except ET.ParseError:
        return items

    def local(elem):
        """Strip namespace from tag for easier matching."""
        return elem.tag.rsplit("}", 1)[-1] if "}" in elem.tag else elem.tag

    def get_text(parent, *names):
        for n in names:
            for child in parent.iter():
                if local(child) == n and child.text:
                    return child.text.strip()
        return ""

    def get_link(parent):
        # Plain <link>URL</link> (RSS) or <link href="URL"/> (Atom)
        for child in parent.iter():
            if local(child) != "link":
                continue
            if child.text and child.text.strip().startswith("http"):
                return child.text.strip()
            href = child.get("href")
            if href:
                return href
        return ""

    # RSS items + Atom entries -- iterate everything tagged "item" or "entry"
    for item in root.iter():
        tag = local(item)
        if tag not in ("item", "entry"):
            continue
        # Skip nested re-iter children (already in the iter pass)
        title = get_text(item, "title")
        link = get_link(item)
        pub = get_text(item, "pubDate", "published", "updated", "date")
        desc = get_text(item, "description", "summary", "content")
        desc = re.sub(r"<[^>]+>", "", desc)[:300].strip()
        if title:
            items.append({"title": title[:200], "url": link, "published": pub, "summary": desc})
        if len(items) >= 20:
            break
    # Dedupe by URL+title preserving order
    seen = set(); dedup = []
    for it in items:
        key = (it["url"], it["title"])
        if key in seen: continue
        seen.add(key); dedup.append(it)
    return dedup[:15]


def _scrape_headlines(html: str, base_url: str) -> list[dict]:
    """Last-resort: grab <a> tags inside <article>/<h1-3> elements as headlines."""
    items = []
    seen_urls = set()
    # Pull links from headline-ish containers
    for tag in ("article", "h1", "h2", "h3"):
        for m in re.finditer(rf"<{tag}[^>]*>(.*?)</{tag}>", html[:300000], re.I | re.S):
            block = m.group(1)
            link_match = re.search(r'href="([^"#]+)"[^>]*>([^<]{8,200})</a>', block, re.I)
            if link_match:
                href = link_match.group(1)
                title = re.sub(r"\s+", " ", link_match.group(2)).strip()
                if not href.startswith("http"):
                    if href.startswith("//"):
                        href = "https:" + href
                    elif href.startswith("/"):
                        href = base_url.rstrip("/") + href
                if href in seen_urls:
                    continue
                seen_urls.add(href)
                items.append({"title": title[:200], "url": href, "published": "", "summary": ""})
            if len(items) >= 12:
                break
        if len(items) >= 12:
            break
    return items


RSS_OVERRIDES_PATH = ROOT / "config" / "rss_overrides.yaml"
_rss_overrides_cache: dict | None = None


def _rss_overrides() -> dict:
    global _rss_overrides_cache
    if _rss_overrides_cache is None:
        if RSS_OVERRIDES_PATH.exists():
            try:
                import yaml as _yaml
                _rss_overrides_cache = _yaml.safe_load(RSS_OVERRIDES_PATH.read_text()) or {}
            except Exception:
                _rss_overrides_cache = {}
        else:
            _rss_overrides_cache = {}
    return _rss_overrides_cache


def _pull_one(domain: str) -> dict:
    base = f"https://{domain}"
    items: list[dict] = []
    used_path = ""
    # 1. Curated override -- known-good RSS URL for this domain
    overrides = _rss_overrides()
    if domain in overrides:
        url = overrides[domain]
        text = _try_curl(url, timeout=8)
        if text:
            items = _parse_rss(text)
            if items:
                used_path = url
    # 2. Auto-discover RSS at common paths
    if not items:
        for path in RSS_PATHS:
            text = _try_curl(base + path, timeout=6)
            if text and ("<rss" in text[:500].lower() or "<feed" in text[:500].lower()):
                items = _parse_rss(text)
                if items:
                    used_path = path
                    break
    method = "rss" if items else "scrape"
    # 3. HTML scrape fallback
    if not items:
        html = _try_curl(base, timeout=8)
        if html:
            items = _scrape_headlines(html, base)
    return {"domain": domain, "method": method, "rss_path": used_path,
            "items": items, "fetched_at": datetime.now().isoformat()}


