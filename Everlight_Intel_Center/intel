        for r in summary.get("dashboard_routes", [])
    )
    osint_rows_html = "".join(
        f'<tr><td class="mono">{r["path"]}</td><td class="num">{r["code"]}</td>'
        f'<td>{"<span class=chip-green>OK</span>" if r["ok"] else "<span class=chip-red>FAIL</span>"}</td></tr>'
        for r in summary.get("osint_routes", [])
    )
    theme_rows_html = "".join(
        f'<tr><td class="mono">{r["file"]}</td><td class="num">{r["size_kb"]} KB</td>'
        f'<td class="num">{r["score"]}/100</td>'
        f'<td>{("<span class=chip-red>missing: " + ", ".join(r["missing"]) + "</span>") if r["missing"] else "<span class=chip-green>perfect</span>"}</td></tr>'
        for r in summary.get("theme_check", {}).get("results", [])
    )
    art_404_html = "".join(f'<li class="mono">{u}</li>' for u in art.get("samples_404", []))

    html_out = f"""<!DOCTYPE html>
