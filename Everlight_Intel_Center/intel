def cmd_investigate(args: list[str]) -> None:
    """
    Trigger an OSINT investigation. Supports attribution + verification.

    Flags (parsed inline):
      --triggered-by=<id>      # default: cli_user
      --lead-id=<id>           # link investigation to a Wholesale lead row
      --verify-state=<2-char>  # enable identity verification by state
      --verify-city=<city>
      --verify-email=<email>
      --verify-phone=<phone>
      --verify-address=<addr>
    """
    if not args:
        sys.exit("usage: intel investigate <target> [--triggered-by=<id>] [--verify-state=CA] [--verify-city=...]")

    target_parts = []
    triggered_by = "cli_user"
    lead_id: int | None = None
    verify_ctx: dict = {}
    purpose = ""
    for a in args:
        if a.startswith("--triggered-by="):
            triggered_by = a.split("=", 1)[1].strip()
        elif a.startswith("--lead-id="):
            try: lead_id = int(a.split("=", 1)[1])
            except ValueError: pass
        elif a.startswith("--verify-state="):
            verify_ctx["state"] = a.split("=", 1)[1].strip()
        elif a.startswith("--verify-city="):
            verify_ctx["city"] = a.split("=", 1)[1].strip()
        elif a.startswith("--verify-email="):
            verify_ctx["owner_email"] = a.split("=", 1)[1].strip()
        elif a.startswith("--verify-phone="):
            verify_ctx["owner_phone"] = a.split("=", 1)[1].strip()
        elif a.startswith("--verify-address="):
            verify_ctx["address"] = a.split("=", 1)[1].strip()
        elif a.startswith("--purpose="):
            purpose = a.split("=", 1)[1].strip()
        elif not a.startswith("--"):
            target_parts.append(a)
    target = " ".join(target_parts).strip()
    if not target:
        sys.exit(f"{RED}Missing target.{RESET}")
    if verify_ctx:
        verify_ctx["owner_name"] = target

    # Business purpose is REQUIRED per Everlight compliance doctrine
    if not purpose:
        try:
            print(f"{GOLD}Per Everlight compliance doctrine, every investigation must record a business purpose.{RESET}")
            print(f"{DIM}Why are you researching this target? (e.g. 'wholesale lead recon', 'self-audit', 'due diligence on vendor X'){RESET}")
            purpose = input(f"{GOLD}Purpose: {RESET}").strip()
        except (EOFError, KeyboardInterrupt):
            sys.exit(f"\n{RED}Aborted -- business_purpose required.{RESET}")
    if not purpose:
        sys.exit(f"{RED}Aborted -- business_purpose required (use --purpose=\"...\" or answer the prompt).{RESET}")

    badge = f" [triggered_by={triggered_by}"
    if lead_id is not None: badge += f", lead_id={lead_id}"
    if verify_ctx: badge += f", verifying with {len(verify_ctx)-1} signal(s)"
    badge += "]"
    print(f"{GOLD}Investigating: {target}{RESET} {DIM}{badge}{RESET}")
    print(f"{DIM}Purpose: {purpose}{RESET}\n")
    try:
        sys.path.insert(0, str(ROOT))
        from osint_api.orchestrator import run_investigation_sync
        from osint_api import compliance_log, legal_state
        # Log the investigation start to compliance_log
        state_rules = legal_state.state_rules_for(verify_ctx.get("state", ""))
        compliance_log.log_action(
            action="investigate", target=target, actor=triggered_by,
            lead_id=lead_id, business_purpose=purpose,
            state=verify_ctx.get("state", ""), state_rules=state_rules,
            notes="cli investigate",
        )
        results, inv_id = run_investigation_sync(
            target, triggered_by=triggered_by, lead_id=lead_id,
            verify_context=verify_ctx or None, business_purpose=purpose)
        for inv in results:
            color = GREEN if inv.get("ok") else RED
            mark = "✓" if inv.get("ok") else "✗"
            print(f"\n  {color}{mark}{RESET} {GOLD}{inv['investigator']}{RESET}  "
                  f"{DIM}({inv.get('elapsed_ms',0)}ms){RESET}")
            for finding in inv.get("findings", [])[:5]:
                v = finding.get("verification")
                if v:
                    conf = v.get("confidence", 0)
                    conf_col = GREEN if conf >= 70 else (CYAN if conf >= 50 else RED)
                    conf_str = f" {conf_col}[conf={conf}]{RESET}"
                else:
                    conf_str = ""
                print(f"      {BOLD}{finding.get('label','')}{RESET}: {finding.get('value','')[:100]}{conf_str}")
        if inv_id:
            report_url = f"http://127.0.0.1:2301/report/{inv_id}"
            print(f"\n{GOLD}{BOLD}Profile Report:{RESET}")
            print(f"  {GOLD}{report_url}{RESET}")
            print(f"  {DIM}Static snapshot: http://127.0.0.1:2300/cache/reports/{inv_id}.html{RESET}")
            # Auto-open unless --no-open passed
            if "--no-open" not in sys.argv:
                _open_url(report_url)
        print(f"{DIM}triggered_by={triggered_by}, purpose='{purpose[:50]}'{RESET}")
    except Exception as e:
        sys.exit(f"{RED}Investigation failed: {e}{RESET}")


def _open_url(url: str) -> bool:
    """Try every common URL opener. Returns True if one succeeded."""
    for opener in ("termux-open-url", "xdg-open", "open"):
        if shutil.which(opener):
            try:
                subprocess.Popen([opener, url],
                                  stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL)
                print(f"  {DIM}opened in browser via {opener}{RESET}")
                return True
            except Exception:
                continue
    # Android `am start` fallback (Termux without termux-open-url)
    if shutil.which("am"):
        try:
            subprocess.Popen(["am", "start", "-a", "android.intent.action.VIEW", "-d", url],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"  {DIM}opened in browser via am start{RESET}")
            return True
        except Exception:
            pass
    print(f"  {DIM}(no URL opener found -- copy the URL above into a browser){RESET}")
    return False


def cmd_team_usage(args: list[str]) -> None:
    """
    Team usage telemetry: who triggered what, when, and where.
    Aggregates investigations + live_pulls + lead enrichments + article freshness.
    Emits branded HTML report at audit_reports/team_usage_<ts>.html.
    """
    from datetime import timedelta
    sys.path.insert(0, str(ROOT))

    INVESTIGATIONS_DB = ROOT / "cache" / "investigations.sqlite"
    LIVE_LOG_DB = ROOT / "cache" / "live_log.sqlite"
    ARTICLES_DB = ROOT / "cache" / "articles.sqlite"
    LEADS_DB = WORKSPACE / "01_BUSINESSES" / "Everlight_Ventures" / "Wholesale" / "leads_db.sqlite"

    report_dir = ROOT / "audit_reports"
    report_dir.mkdir(parents=True, exist_ok=True)

    now = datetime.now()
    cutoff_7d = (now - timedelta(days=7)).isoformat()
    cutoff_30d = (now - timedelta(days=30)).isoformat()
    cutoff_24h = (now - timedelta(hours=24))

    print(f"{GOLD}{BOLD}== Team usage telemetry =={RESET}\n")

    # --- Investigations ---
    inv_total = 0; inv_7d = 0; inv_30d = 0
    inv_by_trigger: dict[str, int] = {}
    inv_by_kind: dict[str, int] = {}
    top_targets: dict[str, int] = {}
    if INVESTIGATIONS_DB.exists():
        c = sqlite3.connect(INVESTIGATIONS_DB)
        try:
            inv_total = c.execute("SELECT COUNT(*) FROM investigations").fetchone()[0]
            inv_7d = c.execute("SELECT COUNT(*) FROM investigations WHERE started_at >= ?", (cutoff_7d,)).fetchone()[0]
            inv_30d = c.execute("SELECT COUNT(*) FROM investigations WHERE started_at >= ?", (cutoff_30d,)).fetchone()[0]
            for row in c.execute("SELECT COALESCE(triggered_by, '(legacy)'), COUNT(*) FROM investigations GROUP BY 1 ORDER BY 2 DESC"):
                inv_by_trigger[row[0]] = row[1]
            for row in c.execute("SELECT COALESCE(kind, '(unknown)'), COUNT(*) FROM investigations GROUP BY 1 ORDER BY 2 DESC"):
                inv_by_kind[row[0]] = row[1]
            for row in c.execute("SELECT target, COUNT(*) FROM investigations GROUP BY target ORDER BY 2 DESC LIMIT 20"):
                top_targets[row[0]] = row[1]
        except sqlite3.OperationalError:
            pass
        c.close()

    # --- Live pulls (suite + ad-hoc activity) ---
    pull_by_trigger: dict[str, int] = {}
    pull_timeline_24h: dict[str, int] = {}  # hour bucket -> count
    pull_total = 0
    if LIVE_LOG_DB.exists():
        c = sqlite3.connect(LIVE_LOG_DB)
        pull_total = c.execute("SELECT COUNT(*) FROM live_pulls").fetchone()[0]
        try:
            for row in c.execute("SELECT COALESCE(last_triggered_by, '(legacy)'), COUNT(*) FROM live_pulls GROUP BY 1 ORDER BY 2 DESC LIMIT 15"):
                pull_by_trigger[row[0]] = row[1]
            # 24h hourly buckets
            for row in c.execute("SELECT last_attempt FROM live_pulls WHERE last_attempt IS NOT NULL"):
                try:
                    ts = datetime.fromisoformat(row[0])
                    if ts >= cutoff_24h:
                        bucket = ts.strftime("%Y-%m-%d %H:00")
                        pull_timeline_24h[bucket] = pull_timeline_24h.get(bucket, 0) + 1
                except (ValueError, TypeError):
                    pass
        except sqlite3.OperationalError:
            pass
        c.close()

    # --- Lead enrichments ---
    enriched_leads = 0; total_leads = 0
    if LEADS_DB.exists():
        try:
            c = sqlite3.connect(LEADS_DB)
            total_leads = c.execute("SELECT COUNT(*) FROM leads").fetchone()[0]
            enriched_leads = c.execute(
                "SELECT COUNT(*) FROM leads WHERE intel_enrichment_json IS NOT NULL"
            ).fetchone()[0]
            c.close()
        except sqlite3.OperationalError:
            pass

    # --- Articles freshness ---
    article_total = 0; articles_24h = 0
    sources_by_freshness: list[tuple[str, str, int]] = []
    if ARTICLES_DB.exists():
        try:
            c = sqlite3.connect(ARTICLES_DB)
            article_total = c.execute("SELECT COUNT(*) FROM articles").fetchone()[0]
            cutoff_iso = cutoff_24h.isoformat()
            articles_24h = c.execute(
                "SELECT COUNT(*) FROM articles WHERE fetched_at >= ?", (cutoff_iso,)
            ).fetchone()[0]
            for row in c.execute(
                "SELECT domain, MAX(fetched_at), COUNT(*) FROM articles GROUP BY domain ORDER BY MAX(fetched_at) DESC LIMIT 20"
            ):
                sources_by_freshness.append((row[0], row[1] or "", row[2]))
            c.close()
        except sqlite3.OperationalError:
            pass

    # --- Print summary ---
    print(f"{BOLD}Investigations:{RESET}")
    print(f"  total: {GOLD}{inv_total}{RESET}  |  last 7d: {inv_7d}  |  last 30d: {inv_30d}")
    print(f"  by trigger:")
    for k, v in list(inv_by_trigger.items())[:8]:
        print(f"    {v:>3}  {k}")
    print()
    print(f"{BOLD}Live pulls (suite + ad-hoc):{RESET}")
    print(f"  total domains tracked: {GOLD}{pull_total}{RESET}  |  events in last 24h: {sum(pull_timeline_24h.values())}")
    print(f"  by trigger:")
    for k, v in list(pull_by_trigger.items())[:10]:
        print(f"    {v:>4}  {k}")
    print()
    print(f"{BOLD}Wholesale lead enrichments:{RESET}")
    print(f"  enriched: {GOLD}{enriched_leads}{RESET} / {total_leads} leads in DB")
    print()
    print(f"{BOLD}Articles:{RESET}")
    print(f"  cached: {GOLD}{article_total}{RESET}  |  fetched in last 24h: {articles_24h}")

    # --- Write branded HTML report ---
    summary = {
        "ts": now.isoformat(),
        "investigations": {
            "total": inv_total, "last_7d": inv_7d, "last_30d": inv_30d,
            "by_trigger": inv_by_trigger, "by_kind": inv_by_kind,
            "top_targets": top_targets,
        },
        "pulls": {
            "total": pull_total, "by_trigger": pull_by_trigger,
            "timeline_24h": pull_timeline_24h,
        },
        "leads": {"enriched": enriched_leads, "total": total_leads},
        "articles": {"total": article_total, "last_24h": articles_24h,
                      "sources_by_freshness": sources_by_freshness},
    }

    report_path = _write_usage_report(summary, report_dir)
    print(f"\n{GOLD}Report: {report_path.relative_to(ROOT)}{RESET}")
    print(f"  open: http://127.0.0.1:2300/{report_path.relative_to(ROOT)}")


