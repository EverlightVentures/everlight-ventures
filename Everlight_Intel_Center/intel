def cmd_audit_e2e(args: list[str]) -> None:
    """
    End-to-end audit: dashboard routes, OSINT API, every cached article URL,
    every resource domain (via live_log), theme drift check. Emits a branded
    HTML report at audit_reports/end_to_end_<timestamp>.html.

    Flags:
      --quick       skip suite re-runs (use existing live_log)
      --theme-only  just the theme drift check, no HTTP probes
    """
    quick = "--quick" in args
    theme_only = "--theme-only" in args

    sys.path.insert(0, str(ROOT))
    from osint_api import live_log
    import concurrent.futures as cf

    started = datetime.now()
    report_dir = ROOT / "audit_reports"
    report_dir.mkdir(parents=True, exist_ok=True)

    summary = {
        "ts": started.isoformat(),
        "dashboard_routes": [],
        "osint_routes": [],
        "article_url_check": {"total": 0, "ok": 0, "404": 0, "other": 0, "samples_404": []},
        "live_audit": {},
        "theme_check": {},
        "category_breakdown": [],
    }

    print(f"{GOLD}{BOLD}== End-to-end audit started =={RESET}\n")

    # ---- 1. Theme drift check (always) -----------------------------------
    print(f"{BOLD}[1/5] Theme drift check...{RESET}")
    theme_tokens = ["#c9a84c", "Playfair Display", "Inter", "mesh"]
    theme_results = []
    for html in sorted((ROOT / "09_Dashboard").glob("*.html")) + [ROOT / "osint_api" / "osint.html"]:
        if not html.exists():
            continue
        text = html.read_text(errors="ignore")
        missing = [t for t in theme_tokens if t not in text]
        theme_results.append({
            "file": str(html.relative_to(ROOT)),
            "missing": missing,
            "size_kb": round(html.stat().st_size / 1024, 1),
            "score": 100 - (len(missing) * 25),
        })
        status = GREEN if not missing else (RED if len(missing) > 1 else "")
        mark = "✓" if not missing else "!"
        print(f"  {status}{mark} {html.relative_to(ROOT)}  "
              f"score={100 - len(missing)*25}/100  missing={missing or 'none'}{RESET}")
    summary["theme_check"] = {
        "total_files": len(theme_results),
        "perfect_files": sum(1 for r in theme_results if r["score"] == 100),
        "results": theme_results,
    }

    if theme_only:
        _write_audit_report(summary, report_dir)
        return

    # ---- 2. Dashboard route probes ---------------------------------------
    print(f"\n{BOLD}[2/5] Dashboard route probes (port 2300)...{RESET}")
    routes_dash = [
        ("index.html", 5000),
        ("articles.html", 5000),
        ("audit.html", 5000),
        ("resources.html", 5000),
        ("categories.html", 5000),
        ("agents.html", 5000),
        ("feeds.html", 5000),
        ("resource.html?d=nasa.gov", 5000),
        ("data.js", 100000),
        ("shared.js", 1000),
    ]
    for path, min_bytes in routes_dash:
        try:
            r = subprocess.run(
                ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}|%{size_download}",
                 f"http://127.0.0.1:2300/09_Dashboard/{path}"],
                capture_output=True, text=True, timeout=8,
            )
            code, _, size = r.stdout.partition("|")
            code = int(code or 0); size = int(size or 0)
            ok = code == 200 and size >= min_bytes
            mark = GREEN + "✓" if ok else RED + "✗"
            print(f"  {mark}{RESET} {path:<32}  HTTP {code}  {size:>6}b  "
                  f"{'(min ' + str(min_bytes) + ')' if not ok else ''}")
            summary["dashboard_routes"].append({"path": path, "code": code, "bytes": size, "ok": ok})
        except subprocess.TimeoutExpired:
            print(f"  {RED}✗{RESET} {path:<32}  TIMEOUT")
            summary["dashboard_routes"].append({"path": path, "code": 0, "bytes": 0, "ok": False, "err": "timeout"})

    # ---- 3. OSINT API probes ---------------------------------------------
    print(f"\n{BOLD}[3/5] OSINT API probes (port 2301)...{RESET}")
    routes_osint = ["/healthz", "/sources", "/live-audit", "/investigations", "/"]
    for path in routes_osint:
        try:
            r = subprocess.run(
                ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}",
                 f"http://127.0.0.1:2301{path}"],
                capture_output=True, text=True, timeout=8,
            )
            code = int(r.stdout or 0)
            ok = 200 <= code < 400
            mark = GREEN + "✓" if ok else RED + "✗"
            print(f"  {mark}{RESET} {path:<24}  HTTP {code}")
            summary["osint_routes"].append({"path": path, "code": code, "ok": ok})
        except subprocess.TimeoutExpired:
            print(f"  {RED}✗{RESET} {path:<24}  TIMEOUT")

    # ---- 4. Cached article URL check --------------------------------------
    print(f"\n{BOLD}[4/5] Cached article URL HEAD check (parallel)...{RESET}")
    art_db = ROOT / "cache" / "articles.sqlite"
    article_urls = []
    if art_db.exists():
        ac = sqlite3.connect(art_db)
        article_urls = [u for (u,) in ac.execute(
            "SELECT DISTINCT url FROM articles WHERE url LIKE 'http%'"
        ).fetchall()][:300]  # cap at 300 to keep audit under 5 min
        ac.close()
    print(f"  testing {len(article_urls)} URLs (cap 300)...")

    def _head(url):
        try:
            r = subprocess.run(
                ["curl", "-sI", "-o", "/dev/null", "-w", "%{http_code}",
                 "--max-time", "6", "-A", "Mozilla/5.0 (compatible; EverlightIntel/1.0)",
                 url],
                capture_output=True, text=True, timeout=8,
            )
            return url, int(r.stdout or 0)
        except Exception:
            return url, 0

    art_404s = []
    art_ok = 0
    art_other = 0
    if article_urls:
        with cf.ThreadPoolExecutor(max_workers=8) as ex:
            done = 0
            for url, code in ex.map(_head, article_urls):
                done += 1
                if 200 <= code < 400:
                    art_ok += 1
                elif code == 404:
                    art_404s.append(url)
                else:
                    art_other += 1
                if done % 50 == 0:
                    print(f"    ... {done}/{len(article_urls)}  ok={art_ok}  404={len(art_404s)}")
    summary["article_url_check"] = {
        "total": len(article_urls),
        "ok": art_ok,
        "404": len(art_404s),
        "other": art_other,
        "samples_404": art_404s[:20],
    }
    print(f"  {GREEN}✓{RESET} ok={art_ok}  {RED}404={len(art_404s)}{RESET}  other={art_other}")

    # ---- 5. Live audit snapshot + per-category breakdown ------------------
    print(f"\n{BOLD}[5/5] Live audit snapshot + per-category breakdown...{RESET}")
    s = live_log.stats(window_days=30)
    summary["live_audit"] = s

    con = open_db()
    cat_rows = []
    for cat, total in con.execute(
        "SELECT category, COUNT(*) FROM resources GROUP BY category ORDER BY 2 DESC"
    ).fetchall():
        # how many of this category's domains are live in live_log?
        domains = [d for (d,) in con.execute(
            "SELECT domain FROM resources WHERE category=? AND domain != ''", (cat,)
        ).fetchall()]
        if not domains:
            cat_rows.append({"category": cat, "total": total, "live": 0, "dead": 0, "untested": total})
            continue
        live_domains = set(live_log.live_active_domains(window_days=30))
        live_count = sum(1 for d in domains if d in live_domains)
        # dead = attempted but no recent success
        attempted = set()
        for r in live_log.all_records():
            if r["domain"] in domains:
                attempted.add(r["domain"])
        dead = len(attempted) - live_count
        untested = total - len(attempted)
        cat_rows.append({"category": cat, "total": total, "live": live_count,
                         "dead": dead, "untested": untested})
    summary["category_breakdown"] = cat_rows
    print(f"  live_active: {GOLD}{s['live_active']}{RESET} of {s['total_attempted']} attempted "
          f"({s['live_active']*100//max(s['total_attempted'],1)}%)")

    # ---- Render branded HTML report ---------------------------------------
    report_path = _write_audit_report(summary, report_dir)
    print(f"\n{GOLD}{BOLD}== Audit complete =={RESET}")
    print(f"  report: {report_path.relative_to(ROOT)}")
    print(f"  open:   file://{report_path}")


def _write_audit_report(summary: dict, report_dir: Path) -> Path:
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    out = report_dir / f"end_to_end_{ts}.html"

    # KPIs
    live = summary.get("live_audit", {}).get("live_active", 0)
    total_attempted = summary.get("live_audit", {}).get("total_attempted", 0)
    live_pct = (live * 100 // max(total_attempted, 1)) if total_attempted else 0
    art = summary.get("article_url_check", {})
    dash_ok = sum(1 for r in summary.get("dashboard_routes", []) if r.get("ok"))
    dash_total = len(summary.get("dashboard_routes", []))
    osint_ok = sum(1 for r in summary.get("osint_routes", []) if r.get("ok"))
    osint_total = len(summary.get("osint_routes", []))
    theme_perfect = summary.get("theme_check", {}).get("perfect_files", 0)
    theme_total = summary.get("theme_check", {}).get("total_files", 0)

    # Per-category bars
    cat_rows_html = ""
    for c in sorted(summary.get("category_breakdown", []), key=lambda x: -x["live"]):
        live_pct_c = (c["live"] * 100 // max(c["total"], 1)) if c["total"] else 0
        dead_pct_c = (c["dead"] * 100 // max(c["total"], 1)) if c["total"] else 0
        cat_rows_html += f"""
        <tr>
          <td>{c['category']}</td>
