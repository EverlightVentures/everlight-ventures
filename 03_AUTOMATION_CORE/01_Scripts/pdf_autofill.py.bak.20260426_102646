def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--deal-id", help="UUID of a Deal in the broker_ops DB")
    ap.add_argument("--json", help="Ad-hoc inline JSON dict for a deal (override / no DB)")
    ap.add_argument("--dry-run", action="store_true", help="Render but log unmapped tokens; do not write PDF")
    ap.add_argument("--out-dir", help="Override output directory")
    args = ap.parse_args()

    template = load_template()

    is_real_deal = False
    if args.deal_id:
        try:
            deal = Deal.objects.select_related("lead").get(id=args.deal_id)
        except Deal.DoesNotExist:
            log.error(f"no Deal found with id {args.deal_id}")
            return 2
        ctx = deal_to_context(deal)
        deal_token = str(deal.id)
        # A --deal-id run without --dry-run means a real contract for a real
        # homeowner. That is the path that ships to a buyer and creates legal
        # exposure if disclosures are missing.
        is_real_deal = not args.dry_run
    elif args.json:
        try:
            data = json.loads(args.json)
        except json.JSONDecodeError as exc:
            log.error(f"bad json: {exc}")
            return 2
        # Build a minimal stub for the context.
        ctx = {**ASSIGNOR_BLOCK, **{k: str(v) for k, v in data.items() if v is not None}}
        for k in ("PROPERTY_ADDRESS", "SELLER_NAME", "STATE"):
            ctx.setdefault(k, "[PENDING]")
        deal_token = data.get("id") or "adhoc_" + datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    else:
        log.error("provide --deal-id or --json")
        return 2

    # Compliance gate: load state-specific disclosure appendix BEFORE we render.
    # State codes are uppercased in deal_to_context; --json may pass mixed case.
    state_code = (ctx.get("STATE", "") or "").strip().upper()
    appendix_md = _load_state_appendix(state_code)

    if appendix_md is None and is_real_deal:
        # No appendix for this state. For a real deal that means we have no
        # vetted disclosure block to attach. CA (CC 1695) and OH (ORC 1349.61)
        # carry direct statutory penalties; other distress-state regimes likely
        # do too. Block the build, escalate Justine, do NOT ship.
        log.warning(
            f"no compliance appendix for state {state_code!r}; "
            f"contract generation blocked, escalating Justine."
        )
        try:
            DealEvent.objects.create(
                deal_id=args.deal_id,
                event_type="legal_flagged",
                title=f"Compliance block: missing {state_code} disclosure appendix",
                detail=(
                    f"pdf_autofill.py refused to generate the assignment contract "
                    f"because no state-specific disclosure appendix is registered "
                    f"for state {state_code!r}. CA (CC 1695) and OH (ORC 1349.61) "
                    f"have direct statutory penalties for missing disclosures; "
                    f"any other distress-state regime likely does too. Escalating "
                    f"to Justine Park to draft and approve the appendix before "
                    f"this deal moves to signing."
                ),
                agent_name="Justine Park",
                metadata={
                    "reason": "missing_state_appendix",
                    "state": state_code,
                    "script": "pdf_autofill.py",
                    "escalate_to": "Justine Park (Compliance Gate)",
                },
            )
        except Exception as exc:
            log.warning(f"could not log DealEvent for compliance block: {exc}")
        return 3

    filled_md, unmapped = render(template, ctx, dry_run=args.dry_run)

    # If we have an appendix, append it AFTER the placeholder pass so any
    # tokens inside the appendix render as literal markdown (the appendix is
    # static legal text, not a template).
    if appendix_md:
        filled_md = filled_md.rstrip() + APPENDIX_SEPARATOR + appendix_md.lstrip()
        log.info(f"attached {state_code} compliance appendix ({len(appendix_md)} bytes)")

    out_root = Path(args.out_dir) if args.out_dir else (OUT_DIR_BASE / deal_token)
    out_root.mkdir(parents=True, exist_ok=True)

    md_path = out_root / "assignment.md"
    html_path = out_root / "assignment.html"
    pdf_path = out_root / "assignment.pdf"

    md_path.write_text(filled_md, encoding="utf-8")
    log.info(f"wrote {md_path}")

    html_path.write_text(md_to_html(filled_md), encoding="utf-8")
    log.info(f"wrote {html_path}")

    if not args.dry_run:
        if md_to_pdf(filled_md, pdf_path):
            log.info(f"wrote {pdf_path}")

    if unmapped:
        log.warning(f"{len(unmapped)} unmapped placeholders remain: {unmapped[:8]}{'...' if len(unmapped) > 8 else ''}")
    else:
        log.info("all placeholders mapped")

    sig_url = maybe_send_to_documenso(
        Deal.objects.get(id=args.deal_id) if args.deal_id else None,
        pdf_path,
    )
    if sig_url:
        log.info(f"Documenso signing URL: {sig_url}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
