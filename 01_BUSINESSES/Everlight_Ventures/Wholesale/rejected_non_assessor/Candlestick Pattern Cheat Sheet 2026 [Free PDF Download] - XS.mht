@keyframes rotateAnimation { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

form .pas-input-input:focus, .pas-textarea-input:focus, .pas-number-container:focus-within, .pas-radio-input-container > input:focus, .pas-phone-number:focus-within, .pas-date-input:focus, .pas-dropdown-input:focus, .pas-optin > input:focus { outline: rgb(0, 102, 238) solid 1px; }

