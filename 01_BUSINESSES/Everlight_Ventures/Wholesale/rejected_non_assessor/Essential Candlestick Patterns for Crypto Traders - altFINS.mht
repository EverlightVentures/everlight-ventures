------MultipartBoundary--RNGdzYERvkliX6QFTSKswT3rLZDlSkGbf1KgLOvNy9----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://f.vimeocdn.com/p/4.46.32/css/player.css

@charset "utf-8";

@keyframes buffer { 
  100% { transform: translateX(-10px); }
}

@keyframes throb { 
  0%, 100% { background-color: rgb(85, 85, 85); }
  50% { background-color: rgb(68, 68, 68); }
}

@keyframes wiggle { 
  0% { transform: translateY(10px); }
  20% { transform: translateY(0px); }
  40%, 80% { transform: translateX(8px); }
  60% { transform: translateX(-8px); }
  100% { transform: translateX(0px); }
}

@keyframes pulse { 
  50% { transform: scale(0.9); }
}

@keyframes dash { 
  0% { stroke-dasharray: 1, 200; stroke-dashoffset: 0; }
  50% { stroke-dasharray: 89, 200; stroke-dashoffset: -35px; }
  100% { stroke-dasharray: 89, 200; stroke-dashoffset: -135px; }
}

@keyframes rotate { 
  100% { transform: rotate(360deg); }
}

@keyframes scaleAnimation { 
  0% { transform: scale(0.9, 0.9); }
  100% { transform: scale(1, 1); }
}

:-webkit-full-screen-ancestor > :not(:-webkit-full-screen-ancestor):not(:-webkit-full-screen) { display: none !important; }

