def cmd_coverage(args: list[str]) -> None:
    """
    Show per-state and per-category breakdown of domain coverage:
    live / auth_gated / dead / untested.
    """
    sys.path.insert(0, str(ROOT))
    from osint_api.domain_status import stats as _ds_stats, status_map as _ds_map
    b = _ds_stats()
    total = sum(b.values()) or 1
    print(f"{GOLD}{BOLD}== Domain coverage =={RESET}")
    print()
    for k, color in [("live", GREEN), ("auth_gated", GOLD), ("rate_limited", "\033[33m"),
                      ("dead", RED), ("untested", DIM)]:
        n = b.get(k, 0)
        pct_val = n * 100 // total
        bar = "█" * (pct_val // 2) + DIM + "░" * (50 - pct_val // 2) + RESET
        print(f"  {color}{k:<14}{RESET} {n:>4}  ({pct_val:>3}%)  {bar}")
    print()
    print(f"  Total tested: {GOLD}{total}{RESET}")

    # Per-category breakdown
    status_map = _ds_map()
    con = open_db()
    print()
    print(f"{BOLD}By category:{RESET}")
    rows = con.execute(
        "SELECT category, domain FROM resources WHERE domain != ''"
    ).fetchall()
    by_cat: dict[str, dict] = {}
    for cat, dom in rows:
        s = status_map.get(dom.lower(), "untested")
        if cat not in by_cat:
            by_cat[cat] = {"live": 0, "auth_gated": 0, "rate_limited": 0, "dead": 0, "untested": 0}
        by_cat[cat][s] = by_cat[cat].get(s, 0) + 1
    for cat in sorted(by_cat, key=lambda c: -by_cat[c]["live"]):
        s = by_cat[cat]
        t = sum(s.values()) or 1
        print(f"  {GOLD}{cat[:38]:<38}{RESET} live={GREEN}{s['live']:>3}{RESET}/{t:<3} "
              f"auth={s.get('auth_gated',0):>2} dead={RED}{s.get('dead',0):>3}{RESET} "
              f"untested={s.get('untested',0):>3}")


def cmd_purge_target(args: list[str]) -> None:
    """
    Right-to-deletion (CCPA §1798.105). Removes everything we have on a target.

    Deletes:
      - cache/investigations/<id>.json files where target matches
      - cache/reports/<id>.html files where target matches
      - investigations.sqlite rows
      - leads_db.sqlite intel_enrichment_json column (cleared)

    Preserves (for legal hold, 7-year retention):
      - compliance_log rows -- target/notes redacted, but the audit row stays

    Adds to DNC: permanent block on contact.

    Usage: intel purge-target "Linda Smith"
    """
    if not args:
        sys.exit("usage: intel purge-target \"<name or address>\"")
    target = " ".join(args).strip().strip('"').strip("'")
    if not target:
        sys.exit(f"{RED}Empty target.{RESET}")

    print(f"{GOLD}{BOLD}== Right-to-Deletion: '{target}' =={RESET}\n")
    print(f"{RED}This will permanently remove ALL data on this target.{RESET}")
    try:
        confirm = input(f"{GOLD}Type the target name to confirm: {RESET}").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit(f"\n{RED}Aborted.{RESET}")
    if confirm != target:
        sys.exit(f"{RED}Confirmation didn't match -- aborted.{RESET}")

    sys.path.insert(0, str(ROOT))
    from osint_api import compliance_log
    deleted = {"investigations": 0, "reports": 0, "sqlite_rows": 0, "leads_rows": 0}

    # 1. SQLite rows in investigations.sqlite
    inv_db = ROOT / "cache" / "investigations.sqlite"
    matched_ids = []
    if inv_db.exists():
        try:
            con = sqlite3.connect(inv_db)
            rows = con.execute(
                "SELECT id, file_path FROM investigations WHERE LOWER(target)=LOWER(?)",
                (target,)
            ).fetchall()
            matched_ids = [r[0] for r in rows]
            for inv_id, file_path in rows:
                if file_path and Path(file_path).exists():
                    Path(file_path).unlink()
                    deleted["investigations"] += 1
            con.execute("DELETE FROM investigations WHERE LOWER(target)=LOWER(?)", (target,))
            deleted["sqlite_rows"] = con.total_changes
            con.commit(); con.close()
        except sqlite3.Error as e:
            print(f"{RED}sqlite error: {e}{RESET}")

    # 2. Rendered report HTMLs
    reports_dir = ROOT / "cache" / "reports"
    if reports_dir.exists():
        for inv_id in matched_ids:
            html_path = reports_dir / f"{inv_id}.html"
            if html_path.exists():
                html_path.unlink()
                deleted["reports"] += 1

    # 3. Wholesale leads_db intel_enrichment_json column
    leads_db = WORKSPACE / "01_BUSINESSES" / "Everlight_Ventures" / "Wholesale" / "leads_db.sqlite"
    if leads_db.exists():
        try:
            con = sqlite3.connect(leads_db)
            con.execute(
                "UPDATE leads SET intel_enrichment_json=NULL WHERE LOWER(owner_name)=LOWER(?)",
                (target,)
            )
            deleted["leads_rows"] = con.total_changes
            con.commit(); con.close()
        except sqlite3.OperationalError:
            pass

    # 4. Compliance log: PRESERVE rows but redact target text (7-year legal hold)
    try:
        log_db = ROOT / "cache" / "compliance.sqlite"
        if log_db.exists():
            con = sqlite3.connect(log_db)
            con.execute(
                "UPDATE compliance_log SET target='[REDACTED]', notes='[REDACTED]' "
                "WHERE LOWER(target)=LOWER(?)", (target,)
            )
            con.commit(); con.close()
    except sqlite3.Error:
        pass

    # 5. Log the purge as a compliance event
    compliance_log.log_action(
        action="purge", target=target, actor="cli_user",
        notes=f"Right-to-deletion executed. Deleted: {json.dumps(deleted)}",
    )

    print()
    print(f"{GREEN}✓ Purge complete:{RESET}")
    print(f"  Investigation JSON files deleted:  {deleted['investigations']}")
    print(f"  Rendered HTML reports deleted:     {deleted['reports']}")
    print(f"  SQLite rows deleted:               {deleted['sqlite_rows']}")
    print(f"  Lead enrichment cleared:           {deleted['leads_rows']}")
    print(f"  Compliance log: target redacted (7-year legal hold preserved)")
    print(f"\n{GOLD}Consider adding '{target}' to Wholesale/compliance/dnc_list.json to prevent re-investigation.{RESET}")


def cmd_deal(args: list[str]) -> None:
    """`intel deal launch|status|verify|fire <key>` -- autonomous deal arc engine.

    Subcommands:
      intel deal launch <key>           Kick off the M1 cold intro (real send to seller_email
                                        from deal_meta.json; use test_mode for self-test)
      intel deal status <key>           Print audit timeline + last stage
      intel deal verify <key>           Verify hash chain integrity for this deal
      intel deal fire <key> <step>      Fire a specific arc step (m1_intro/m3_open/m5_meet/m7_contract)
      intel deal new <key> --test       Initialize a new deal_meta.json in test mode
    """
    import sys as _sys, json as _json
    _sys.path.insert(0, "/mnt/sdcard/AA_MY_DRIVE/Everlight_Intel_Center")
    _sys.path.insert(0, "/mnt/sdcard/AA_MY_DRIVE/01_BUSINESSES/Everlight_Ventures/Wholesale/audit")
    from osint_api.arc_send import (fire_step, deal_status, ARC_FUNCTIONS,
                                     load_deal_meta, write_deal_meta)
    from deal_execution_log import verify_chain, deal_history

    if not args:
        print(cmd_deal.__doc__ or "")
        return

    sub = args[0]
    if sub == "launch":
        if len(args) < 2:
            print("usage: intel deal launch <deal_key>"); return
        key = args[1]
