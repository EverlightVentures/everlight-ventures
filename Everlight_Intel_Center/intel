def _fetch_one(domain: str, timeout: int = 6) -> dict:
    """Pull title + meta description + first H1 with curl. No third-party deps."""
    url = f"https://{domain}"
    try:
        r = subprocess.run(
            ["curl", "-sL", "--max-time", str(timeout),
             "--max-filesize", "300000", "-A",
             "Mozilla/5.0 (compatible; EverlightIntel/1.0)", url],
            capture_output=True, text=True, timeout=timeout + 2,
        )
        html = r.stdout[:200000]
        ok = r.returncode == 0 and len(html) > 100
    except subprocess.TimeoutExpired:
        return {"domain": domain, "ok": False, "error": "timeout"}
    if not ok:
        return {"domain": domain, "ok": False, "error": f"curl rc={r.returncode}"}

    title = ""
    desc = ""
    h1 = ""
    m = re.search(r"<title[^>]*>(.*?)</title>", html, re.I | re.S)
    if m:
        title = re.sub(r"\s+", " ", m.group(1)).strip()[:140]
    m = re.search(r"""<meta\s+[^>]*name=['"]description['"][^>]*content=['"]([^'"]+)""", html, re.I)
    if not m:
        m = re.search(r"""<meta\s+[^>]*property=['"]og:description['"][^>]*content=['"]([^'"]+)""", html, re.I)
    if m:
        desc = re.sub(r"\s+", " ", m.group(1)).strip()[:200]
    m = re.search(r"<h1[^>]*>(.*?)</h1>", html, re.I | re.S)
    if m:
        h1 = re.sub(r"<[^>]+>", "", m.group(1))
        h1 = re.sub(r"\s+", " ", h1).strip()[:140]
    return {"domain": domain, "ok": True, "title": title, "desc": desc, "h1": h1}


def _fetch_category(category: str, limit: int = 12) -> None:
    if not shutil.which("curl"):
        sys.exit(f"{RED}curl not installed -- `apt install -y curl` first.{RESET}")
    con = open_db()
    rows = con.execute("""
        SELECT domain, purpose, agent_owner FROM resources
        WHERE category = ? AND domain != ''
        ORDER BY (verified_status='checked') DESC, RANDOM()
        LIMIT ?
    """, (category, limit)).fetchall()
    if not rows:
        sys.exit(f"{RED}No domains found for category '{category}'.{RESET}")
    header(f"intel fetch '{category}'", len(rows))
    print(f"  {DIM}Pulling head + meta from {len(rows)} sources (max ~6s each)...{RESET}\n")

    # Run fetches in parallel via threads
    import concurrent.futures as cf
    results = []
    with cf.ThreadPoolExecutor(max_workers=6) as ex:
        futures = {ex.submit(_fetch_one, d): (d, p, a) for d, p, a in rows}
        for fut in cf.as_completed(futures):
            d, p, a = futures[fut]
            try:
                res = fut.result()
            except Exception as e:
                res = {"domain": d, "ok": False, "error": str(e)}
            results.append({"meta": (d, p, a), "fetch": res})

    # Cache the run for downstream consumers (briefings, agents)
    cache_dir = ROOT / "cache" / "fetch"
    cache_dir.mkdir(parents=True, exist_ok=True)
    safe_cat = re.sub(r"[^a-z0-9]+", "_", category.lower()).strip("_")
    cache_file = cache_dir / f"{safe_cat}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
    cache_file.write_text(json.dumps(results, indent=2))

    ok_count = sum(1 for r in results if r["fetch"]["ok"])
    for r in sorted(results, key=lambda x: x["meta"][0]):
        d, p, a = r["meta"]
        f = r["fetch"]
        if not f["ok"]:
            print(f"  {RED}✗ {d:<28}{RESET} {DIM}{f.get('error','?')} -- {p[:40]}{RESET}")
            continue
        title = f.get("title") or f.get("h1") or "(no title)"
        desc = f.get("desc") or p
        print(f"  {GREEN}✓{RESET} {GOLD}{d:<28}{RESET}")
        print(f"      {BOLD}{title[:90]}{RESET}")
        if desc and desc != title:
            print(f"      {DIM}{desc[:140]}{RESET}")
        print(f"      {CYAN}{a}{RESET} {DIM}|  https://{d}{RESET}\n")
    print(f"{DIM}Cached: {cache_file.relative_to(ROOT)}  |  ok={ok_count}/{len(results)}{RESET}")


