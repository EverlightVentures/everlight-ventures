.container { grid-area: page-content; }

.layout-sidebar { display: grid; grid-template-columns: 2fr 1fr; grid-template-areas: "content sidebar"; column-gap: 20px; }

@media (max-width: 1280px) {
  .layout-sidebar { grid-template-columns: 1.5fr 1fr; }
}

@media (max-width: 768px) {
  .layout-sidebar { grid-template-columns: 1fr; grid-template-areas: "content" "sidebar"; row-gap: 20px; }
}

.layout-sidebar--card-table { margin-top: 3.75rem; }

@media (max-width: 992px) {
  .layout-sidebar--card-table { margin-top: 1.875rem; }
}

@media (max-width: 768px) {
  .layout-sidebar--card-table { margin-top: 0px; }
}

.layout-sidebar--slim { grid-template-columns: 3fr 1fr; }

.layout-fullwidth__content { width: 100%; }

.layout__content { grid-area: content; }

.layout__side { grid-area: sidebar; }

.layout__column { grid-area: column; }

.has-top-bar { display: block; padding-top: var(--top-bar-height); }

.has-incidents-bar { --top-bar-height: calc( var(--top-bar-element-height) + var(--incidents-bar-height) ); }

.has-incidents-bar--summary { --top-bar-height: calc( var(--top-bar-element-height) + var(--incidents-bar-summary-height) ); }

.has-incidents-bar--multiline { --top-bar-height: calc( var(--top-bar-element-height) + var(--incidents-bar-multi-height) ); }

.has-main-nav { transition: padding 0.15s; display: block; padding-left: var(--main-nav-width); }

.has-main-nav--pinned { --main-nav-width: var(--main-nav-width-pinned); padding-left: var(--main-nav-width-pinned); }

.content { display: grid; padding-top: var(--gap-outer); padding-bottom: 150px; min-height: calc(100vh - var(--top-bar-height)); background-color: var(--color-background--layer-0); column-gap: var(--gap-outer); grid-template-columns: auto minmax(1px, 1440px) auto; grid-template-areas: ". page-content ."; }

@media (max-width: 992px) {
  .content { padding-bottom: 75px; }
}

.content--global-message { grid-template-areas: "global global global" ". page-content ."; grid-template-rows: auto 1fr; }

.hc-spinner { color: var(--color-primary); }

.keycode { display: inline-block; margin: 0px 6px; padding: 0px 6px; width: auto; min-width: 1.25rem; height: 1.25rem; text-align: center; border-radius: 4px; background-color: var(--color-badge--grey); font-family: Montserrat, Inter, sans-serif; font-size: 0.875rem; font-weight: 500; box-shadow: rgba(0, 0, 0, 0.25) 0px 2px; }

.keycode-hint { display: grid; place-content: center; margin: 0px; width: 1.25rem; min-width: 1.25rem; height: 1.25rem; color: var(--color-text); font-weight: 500; box-shadow: rgba(0, 0, 0, 0.25) 0px 2px; border-radius: 4px; background-color: var(--color-badge--grey); }

.keycode-hint--backspace { font-size: 15px; }

.keycode-hint--char { font-size: 0.5rem; font-weight: 600; }

.keycode-hint--enter { padding-bottom: 0.125rem; }

.keycode-hint--flat { border: 1px solid var(--color-form-border); color: inherit; box-shadow: none; background-color: transparent; width: 1.25rem; height: 1.25rem; font-weight: 600; }

.keycode-hint__item { display: grid; font-size: 0.875rem; grid-auto-flow: column; align-items: center; justify-content: start; column-gap: 6px; }

.keycode-hint--toggle { display: flex; align-items: center; justify-content: center; width: fit-content; padding: 0.25rem; font-family: Inter, sans-serif; }

.keycode-hint__label { font-size: 0.75rem; color: var(--color-text--disabled); }

.clickable { cursor: pointer; }

.more-indicator { display: flex; align-items: center; gap: 0.125rem; }

.more-indicator__plus-number { font-family: Montserrat, Inter, sans-serif; color: rgb(138, 138, 138); font-size: 0.875rem; cursor: pointer; user-select: none; font-weight: 500; }

.ellipsis { display: block; overflow: hidden; text-overflow: ellipsis; max-width: 100%; white-space: nowrap; justify-self: start; }

.content-center-rounded-corner { border: 1px solid var(--color-form-border); border-radius: 6px; display: flex; justify-content: center; padding: 0.375rem; }

.divider { height: 1px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background-color: var(--color-border); margin: 0px; }

.divider--margin { margin: 0.25rem 0px; }

.floating-clear-button { display: grid; justify-content: center; align-items: center; transition: 0.2s; position: absolute; top: -5px; right: -5px; z-index: 1; background: var(--color-background--layer-40); border-radius: 50%; height: 18px; width: 18px; cursor: pointer; }

