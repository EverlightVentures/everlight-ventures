#!/bin/bash
# xws-fg - websocket ticker foreground (for startup supervisors)

set -euo pipefail

# Resolve bot directory dynamically so this script works on phone and Oracle VM.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOT_DIR="${CRYPTO_BOT_DIR:-$SCRIPT_DIR}"
VENV="/tmp/xlm_bot_venv"

cd "$BOT_DIR" || exit 1
bash "$BOT_DIR/_venv.sh"

while true; do
  "$VENV/bin/python" live_ws.py --product XLM-USD
  sleep 2
done
