# Everlight Ventures -- Environment Contract
# Copy to .env and fill in real values.
# NEVER commit .env to git.
#
# Hive Mind: hive_83877943 | 2026-03-10

# ---------------------------------------------------------------------------
# ElevenLabs TTS (primary speech provider)
# Get from: elevenlabs.io -> Profile -> API Key
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice IDs (optional overrides -- defaults set in speech_service.py)
# Find voice IDs at: elevenlabs.io/voice-library
EL_DEALER_VOICE=pNInz6obpgDQGcFmaJgB      # Adam - authoritative male
EL_KIDS_VOICE=EXAVITQu4vr4xnSDxMaL        # Bella - warm expressive
EL_THRILLER_VOICE=VR6AewLTigWG4xSOukaG    # Arnold - deep cinematic
EL_TRAILER_VOICE=ErXwobaYiN019PkySvjV     # Antoni - dramatic
EL_DEFAULT_VOICE=EXAVITQu4vr4xnSDxMaL

# ---------------------------------------------------------------------------
# MiniMax Audio (fallback TTS provider)
# Get from: minimax.chat -> API Keys
# ---------------------------------------------------------------------------
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here

# ---------------------------------------------------------------------------
# OpenAI (legacy audiobook TTS + GPT for scripts)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------------
# Supabase (database + storage + realtime for Lovable)
# Get from: supabase.com -> Project Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Supabase Storage bucket names
SUPABASE_AUDIO_BUCKET=audio-assets
SUPABASE_COVERS_BUCKET=book-covers

# ---------------------------------------------------------------------------
# Google Cloud (Secret Manager, Cloud Run if needed)
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---------------------------------------------------------------------------
# GitHub (for CI/CD and Lovable sync)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=your-org/everlight-app

# ---------------------------------------------------------------------------
# Anthropic Claude (Hive Mind advisor)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------------------------------------
# Stripe (payments)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# ---------------------------------------------------------------------------
# Django (Hive Dashboard)
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# XLM Bot (Coinbase perps trading)
# ---------------------------------------------------------------------------
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here

# ---------------------------------------------------------------------------
# SMTP / Email (Resend for everlightventures.io)
# ---------------------------------------------------------------------------
SMTP_PROVIDER=resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
SMTP_FROM=noreply@everlightventures.io
RESEND_API_KEY=your_resend_api_key_here
