@charset "utf-8";

.cbm-popup { width: 100%; height: 100%; opacity: 0; visibility: hidden; position: fixed; top: 0px; left: 0px; transition: 0.3s ease-in-out; z-index: -1; }

.cbm-popup.open { opacity: 1; visibility: visible; z-index: 999999; }

.cbm-popup__overlay { background: rgb(24, 28, 31); opacity: 0.7; width: 100%; height: 100%; position: absolute; top: 0px; left: 0px; cursor: pointer; display: flex; justify-content: center; align-items: center; }

.cbm-popup__wrap { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }

.cbm-popup__content { width: 480px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 20px; border-radius: 8px; z-index: 1; transform: translateY(-50px); transition: transform 0.3s ease-in-out; }

.cbm-popup.open .cbm-popup__content { transform: translateY(0px); }

.cbm-popup__header { display: flex; justify-content: space-between; align-items: center; padding: 24px; }

.cbm-popup__title-text { font-size: 20px; font-weight: 700; color: rgb(24, 28, 31); }

.cbm-popup__close-btn { background: none; border: none; cursor: pointer; }

button.cbm-popup__close-btn:hover { box-shadow: none !important; background: none !important; }

.cbm-popup__close-btn img { width: 24px; height: 24px; }

.cbm-popup__body { display: flex; padding: 0px 24px 16px; }

.cbm-popup__body-text { font-size: 16px; line-height: 1.5; font-weight: 700; color: rgb(24, 28, 31); }

.cbm-popup__button { padding: 12px; width: 100%; font-size: 16px; font-weight: 600; border-radius: 4px; cursor: pointer; }

.cbm-popup__spinner { display: flex; align-items: center; justify-content: center; }

.cbm-popup__spinner svg { animation: 1s linear 0s infinite normal none running spin; }

@keyframes spin { 
  100% { transform: rotate(360deg); }
}

@media screen and (max-width: 464px) {
  .cbm-popup__wrap { align-items: end; }
}
