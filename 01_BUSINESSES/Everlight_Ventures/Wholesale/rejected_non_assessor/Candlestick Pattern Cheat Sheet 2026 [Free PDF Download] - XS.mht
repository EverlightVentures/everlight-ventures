.hljs { display: block; overflow-x: auto; padding: 0.5em; color: rgb(51, 51, 51); background: rgb(248, 248, 248); }

.diff .hljs-header, .hljs-comment, .hljs-javadoc, .hljs-template_comment { color: rgb(153, 153, 136); font-style: italic; }

.css .rule .hljs-keyword, .hljs-keyword, .hljs-winutils { color: rgb(51, 51, 51); font-weight: 700; }

.hljs-subst, .javascript .hljs-title { color: rgb(51, 51, 51); }

.hljs-request, .hljs-status, .nginx .hljs-title { color: rgb(51, 51, 51); font-weight: 700; }

.hljs-hexcolor, .hljs-number, .ruby .hljs-constant { color: rgb(0, 153, 153); }

.hljs-phpdoc, .hljs-string, .hljs-tag .hljs-value, .tex .hljs-formula { color: rgb(221, 17, 68); }

.coffeescript .hljs-params, .hljs-id, .hljs-title, .scss .hljs-preprocessor { color: rgb(153, 0, 0); font-weight: 700; }

.clojure .hljs-title, .hljs-subst, .javascript .hljs-title, .lisp .hljs-title { font-weight: 400; }

.haskell .hljs-type, .hljs-class .hljs-title, .tex .hljs-command, .vhdl .hljs-literal { color: rgb(68, 85, 136); font-weight: 700; }

.django .hljs-tag .hljs-keyword, .hljs-rules .hljs-property, .hljs-tag, .hljs-tag .hljs-title { color: navy; font-weight: 400; }

.hljs-attribute, .hljs-variable, .lisp .hljs-body { color: teal; }

.hljs-regexp { color: rgb(0, 153, 38); }

.hljs-prompt, .hljs-symbol, .lisp .hljs-keyword, .ruby .hljs-symbol .hljs-string, .tex .hljs-special { color: rgb(153, 0, 115); }

.clojure .hljs-built_in, .hljs-built_in, .lisp .hljs-title { color: rgb(0, 134, 179); }

.hljs-cdata, .hljs-doctype, .hljs-pi, .hljs-pragma, .hljs-preprocessor, .hljs-shebang { color: rgb(153, 153, 153); font-weight: 700; }

.hljs-deletion { background: rgb(255, 221, 221); }

.hljs-addition { background: rgb(221, 255, 221); }

.diff .hljs-change { background: rgb(0, 134, 179); }

.hljs-chunk { color: rgb(170, 170, 170); }

.fc-emoji-picker { background: rgb(255, 255, 255); border: 0px; border-radius: 4px; bottom: 0px; box-shadow: rgba(0, 0, 0, 0.25) 0px 12px 29px; font-family: Helvetica, Arial, sans-serif; height: 50vh; outline: 0px; width: 264px; z-index: 9999; }

.fc-emoji-picker.fc-emoji-picker--limited { height: auto; }

.fc-emoji-picker.fc-emoji-picker--limited .fc-emoji-picker__body { margin: 10px 0px; overflow: auto; }

.fc-emoji-picker::after { border-color: rgb(238, 238, 238) transparent transparent; border-style: solid; border-width: 15px 15px 0px; clear: both; content: ""; display: block; height: 0px; margin-bottom: -15px; position: absolute; right: 17px; top: 100%; width: 0px; }

.fc-emoji-picker, .fc-emoji-picker__header { position: absolute; }

