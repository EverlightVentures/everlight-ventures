def cmd_audit(_: list[str]) -> None:
    """
    For every domain in the DB, grep the workspace to see if we're using it.
    Excludes the Intel Center folder itself (would be 100% self-referential)
    and the FREE RESOURCES source folder. Writes results to audit_latest.json
    and adds in_use + usage_evidence columns to the DB.
    """
    print(f"{GOLD}== Intel audit -- searching the workspace for resource usage =={RESET}")
    con = open_db()
    domains = [d for (d,) in con.execute("SELECT DISTINCT domain FROM resources WHERE domain != ''").fetchall()]
    print(f"  {len(domains)} unique domains to check\n")

    # Add audit columns if not present
    con.execute("CREATE TABLE IF NOT EXISTS audit (domain TEXT PRIMARY KEY, in_use INT, evidence TEXT, checked_at TEXT)")
    con.execute("DELETE FROM audit")

    # Exclude self + source dir + binary/large dirs
    excludes = [
        "--exclude-dir=Everlight_Intel_Center",
        "--exclude-dir=FREE RESOURCES",
        "--exclude-dir=.git",
        "--exclude-dir=node_modules",
        "--exclude-dir=__pycache__",
        "--exclude-dir=.venv",
        "--exclude-dir=08_BACKUPS",
        "--exclude-dir=_logs",
        "--exclude=*.pyc",
        "--exclude=*.sqlite",
        "--exclude=*.jpg",
        "--exclude=*.png",
        "--exclude=*.pdf",
        "--exclude=*.zip",
    ]

    in_use_count = 0
    evidence_lines: list[tuple[str, int, str]] = []
    t0 = time.time()
    # Batch domains into regex alternation (50 at a time) for one grep pass each
    BATCH = 50
    for i in range(0, len(domains), BATCH):
        batch = domains[i:i + BATCH]
        # Escape dots; grep -F isn't an option since we want word-boundary
        alt = "|".join(re.escape(d) for d in batch)
        pattern = rf"(^|[^a-zA-Z0-9])({alt})([^a-zA-Z0-9]|$)"
        try:
            r = subprocess.run(
                ["grep", "-r", "-l", "-E", pattern, "--include=*.py", "--include=*.md",
                 "--include=*.yaml", "--include=*.yml", "--include=*.json", "--include=*.html",
                 "--include=*.ts", "--include=*.tsx", "--include=*.js", "--include=*.jsx",
                 "--include=*.txt", "--include=*.sh", "--include=*.org",
                 *excludes, str(WORKSPACE)],
                capture_output=True, text=True, timeout=120,
            )
            files_with_hits = [Path(p) for p in r.stdout.strip().split("\n") if p]
        except subprocess.TimeoutExpired:
            files_with_hits = []
        # For each file with hits, find which of our domains were the actual matches
        for f in files_with_hits:
            try:
                content = f.read_text(errors="ignore")
            except Exception:
                continue
            for d in batch:
                # Word-boundary-ish check
                if re.search(rf"(^|[^a-zA-Z0-9.]){re.escape(d)}([^a-zA-Z0-9]|$)", content):
                    rel = str(f.relative_to(WORKSPACE)) if f.is_relative_to(WORKSPACE) else str(f)
                    evidence_lines.append((d, 1, rel))
        progress = i + BATCH
        print(f"  {min(progress, len(domains)):>4}/{len(domains)} domains scanned "
              f"({len(evidence_lines)} hits so far, {time.time()-t0:.0f}s)")

    # Aggregate: per-domain hit count + first 3 evidence files
    by_domain: dict[str, list[str]] = {}
    for d, _, rel in evidence_lines:
        by_domain.setdefault(d, []).append(rel)

    now = datetime.now().isoformat()
    for d in domains:
        hits = sorted(set(by_domain.get(d, [])))
        in_use = 1 if hits else 0
        if in_use:
            in_use_count += 1
        evidence = "; ".join(hits[:3])
        con.execute("INSERT INTO audit VALUES (?,?,?,?)", (d, in_use, evidence, now))
    con.commit()

    summary = {
        "ts": now,
        "total": len(domains),
        "in_use": in_use_count,
        "in_use_pct": round(in_use_count * 100 / max(len(domains), 1), 1),
        "elapsed_sec": round(time.time() - t0, 1),
        "top_used": sorted(
            [(d, len(set(by_domain.get(d, [])))) for d in domains if by_domain.get(d)],
            key=lambda x: -x[1])[:25],
    }
    AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
    AUDIT_LOG.write_text(json.dumps(summary, indent=2))
    con.close()

    print(f"\n{GOLD}== Audit complete =={RESET}")
    print(f"  {BOLD}{summary['in_use']}/{summary['total']} ({summary['in_use_pct']}%){RESET} resources actively used in workspace")
    print(f"  Duration: {summary['elapsed_sec']}s")
    print(f"\n{BOLD}Top 15 resources by file references:{RESET}")
    for d, n in summary["top_used"][:15]:
        cat = open_db().execute("SELECT category FROM resources WHERE domain=?", (d,)).fetchone()
        cat_str = cat[0] if cat else "?"
        print(f"  {n:>3} files  {GOLD}{d:<28}{RESET} {DIM}{cat_str}{RESET}")
    print(f"\n{DIM}Run `intel audit-report` to see the full breakdown by category.{RESET}")


