def _detect_relevant_categories(text: str, all_categories: list[str]) -> list[str]:
    """Score categories by keyword frequency in the agent firmware text. Top 4 win."""
    text_lc = text.lower()
    KEYWORDS = {
        "News & Journalism":         ["news", "journalist", "headline", "wire", "breaking", "report", "scoop"],
        "Weather & Disaster Intel":  ["weather", "storm", "disaster", "hurricane", "fema", "emergency", "alert"],
        "Maps & Geospatial":         ["map", "geo", "location", "gis", "satellite", "terrain"],
        "Aviation & Maritime":       ["flight", "aviation", "ship", "marine", "logistics", "airport"],
        "Space & Science":           ["space", "science", "research", "experiment", "physics", "biology"],
        "Economics & Markets":       ["economy", "macro", "inflation", "fomc", "fed", "treasury"],
        "Trading & Finance":         ["trad", "finance", "stock", "crypto", "broker", "portfolio", "earnings"],
        "OSINT & Investigation":     ["osint", "investigat", "lookup", "research", "verify", "wholesale", "skip", "deal", "fraud", "compliance", "background", "source"],
        "Cybersecurity":             ["security", "vuln", "exploit", "breach", "malware", "auth"],
        "AI & Automation":           ["ai", "ml", "agent", "automat", "workflow", "prompt", "llm"],
        "APIs & Developer Tools":    ["api", "code", "develop", "engineer", "dev", "framework", "sdk"],
        "Content Creation":          ["content", "design", "writ", "video", "audio", "image", "copy", "social"],
        "eCommerce & Product Research": ["product", "shop", "ecom", "amazon", "shopify", "supplier"],
        "Real Estate & Property":    ["property", "real estate", "wholesale", "lead", "owner", "deal", "address"],
        "Logistics & Supply Chain":  ["logistic", "supply", "freight", "shipping", "warehouse"],
        "Legal & Compliance":        ["legal", "compliance", "law", "court", "filing", "tos", "gdpr", "hipaa", "ccpa"],
        "Health & Environment":      ["health", "medic", "biotech", "pharma", "environment", "climate"],
        "Education & Training":      ["learn", "tutorial", "course", "education", "train", "skill"],
        "Self-Hosting & Privacy":    ["host", "privacy", "vpn", "encrypt", "self-host", "infra", "deploy"],
        "Decision Intelligence":     ["decision", "strategy", "framework", "analysis", "playbook", "executive"],
    }
    scores = []
    for cat in all_categories:
        hits = sum(1 for kw in KEYWORDS.get(cat, []) if kw in text_lc)
        if hits > 0:
            scores.append((hits, cat))
    scores.sort(reverse=True)
    return [c for _, c in scores[:4]]


def cmd_wire(_: list[str]) -> None:
    """
    Two-tier Intel Center wiring:
    - Tier 1 (named owners, slug match): rich block with their resource count, manifest path,
      and category-specific commands.
    - Tier 2 (every other agent): generic awareness block listing the 4 most-relevant
      categories for that agent's domain (auto-detected by keyword frequency in their firmware).
    """
    agents_dir = WORKSPACE / ".claude" / "agents"
    sources_dir = agents_dir / "sources"
    if not sources_dir.exists():
        sys.exit(f"{RED}Run `intel manifest` first.{RESET}")
    con = open_db()
    owners = {}
    for (a, n) in con.execute(
        "SELECT agent_owner, COUNT(*) FROM resources WHERE agent_owner != '' GROUP BY agent_owner"
    ).fetchall():
        slug = re.sub(r"[^a-z0-9]+", "_", a.lower()).strip("_")
        owners[a] = (slug, n)

    # Per-owner top categories for the rich block
    owner_top_cats = {}
    for owner in owners:
        rows = con.execute(
            "SELECT category, COUNT(*) FROM resources WHERE agent_owner=? GROUP BY category ORDER BY 2 DESC",
            (owner,)
        ).fetchall()
        owner_top_cats[owner] = rows[:5]

    # All categories (for tier 2 keyword detection)
    all_cats = sorted({c for (c,) in con.execute("SELECT DISTINCT category FROM resources").fetchall()})
    total_resources = con.execute("SELECT COUNT(*) FROM resources").fetchone()[0]

    SENTINEL_START = "<!-- INTEL_CENTER_BLOCK_START -->"
    SENTINEL_END = "<!-- INTEL_CENTER_BLOCK_END -->"
    tier1 = 0; tier2 = 0; skipped = 0

    for agent_file in sorted(agents_dir.glob("*.md")):
        if agent_file.name in ("README.md",):
            skipped += 1
            continue
        text = agent_file.read_text(errors="ignore")
        file_slug = agent_file.stem.lower().lstrip("0123456789_")

        # Tier 1: filename slug matches an owner
        owner_match = next(((o, s, n) for o, (s, n) in owners.items() if s == file_slug), None)

        if owner_match:
            owner, slug, n = owner_match
            cats = owner_top_cats.get(owner, [])
            cats_md = "\n".join(f"  - **{c}** ({cnt} resources)" for c, cnt in cats)
            # Per-owner CLI tip
            top_cat = cats[0][0] if cats else ""
            suite_kw = {
                "OSINT & Investigation": "osint_sweep",
                "Trading & Finance": "finance_snapshot",
                "Weather & Disaster Intel": "weather_watch",
                "Space & Science": "space_briefing",
                "News & Journalism": "news_brief",
                "Health & Environment": "health_brief",
                "Aviation & Maritime": "aviation_radar",
                "Decision Intelligence": "decision_intel",
                "Education & Training": "education_brief",
                "Self-Hosting & Privacy": "privacy_self_host",
                "Content Creation": "content_tools",
                "Maps & Geospatial": "maps_geo",
                "AI & Automation": "ai_automation",
                "APIs & Developer Tools": "dev_tools",
                "Real Estate & Property": "real_estate_watch",
                "Legal & Compliance": "legal_lookup",
                "eCommerce & Product Research": "ecommerce_scout",
                "Economics & Markets": "markets_macro",
            }.get(top_cat, "")
            suite_line = f"- **Refresh your live data:** `intel suite {suite_kw}` -- pulls every domain in your top category" if suite_kw else ""
            investigate_line = "- **Run an OSINT investigation:** `intel investigate <target>` -- streams findings from 10 investigators (port 2301)" if "OSINT" in top_cat or n >= 50 else ""

            block = f"""
{SENTINEL_START}
## Intel Center Sources -- Tier 1 Owner

You are the **assigned owner of {n} resources** in the Everlight Intel Center, spread across:

{cats_md}

### How to use them in YOUR workflow

- **Your full manifest** (with use_case + setup per resource): `.claude/agents/sources/{slug}.md`
- **Search across all {total_resources} resources:** `intel search <query>`
