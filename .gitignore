# ============================================================
# HIVE MIND .gitignore
# GitHub = logic/code/docs ONLY. Assets go to Nextcloud.
# ============================================================

# ---- LARGE ASSET DIRECTORIES (Nextcloud only) ----
04_MEDIA_LIBRARY/
08_BACKUPS/
D_Backups/
07_STAGING/

# ---- UNITY / GAME ENGINE (too large for git) ----
**/ArenaAdvance/
**/Library/
**/Temp/
**/Logs/
**/obj/
**/Build/
**/Clash_Carbon/
*.dylib
*.dll
*.so
*.pdb

# ---- LARGE UPLOADS / MEDIA ----
_uploads/
SHIPPING_BOOK_IMAGES/
generation.pid
generation_progress.log

# ---- XLM BOT LOGS (too large for GitHub) ----
06_DEVELOPMENT/xlm_bot/logs/
xlm_bot/logs/

# ---- HIVE DB (too large for GitHub) ----
_logs/hive.db
_logs/blinko_lite.db

# ---- SQLITE DB (runtime) ----
*.sqlite3

# ---- EBOOK SOURCE FILES (large) ----
**/*.epub
**/*.mobi

# ---- SECRETS & CREDENTIALS ----
# Credentials ARE tracked for PC transfer (repo MUST stay PRIVATE)
# WARNING: If this repo EVER becomes public, rotate ALL keys immediately
!03_AUTOMATION_CORE/03_Credentials/
**/credentials/
**/*.json.secret
# 2026-05-16: Reversed prior "track .env for portability" policy.
# Secrets must NEVER live in git, even private repos -- they leak via
# compromised accounts, accidental visibility flips, breaches, forks.
# Sync .env files between nodes via Tailscale/rsync, not git.
# Templates (.env.example) stay tracked -- they document expected vars.
**/*.env
**/.env.bak
**/.env.local
**/.env.production
**/.env.secret
!**/*.env.example
!**/*.env.template
!**/*.env.sample
**/config.json
**/secrets/
**/api_keys*
**/*_key.txt
**/*_token.txt
**/*_secret*
xlm_bot/secrets/
xlm_bot/data/*.json
xlm_bot/logs/
trading/*/secrets/

# ---- BOT RUNTIME DATA (ephemeral, not version-controlled) ----
xlm_bot/data/XLM_*.csv
xlm_bot/data/state.json
xlm_bot/data/trades.csv
xlm_bot/data/signals.jsonl
xlm_bot/data/ai_insight.json
xlm_bot/.heartbeat
_logs/
everlight_os/_logs/

# ---- OLD CRYPTO BOT (runtime state only, not code) ----
03_AUTOMATION_CORE/01_Scripts/crypto_bot/data/
03_AUTOMATION_CORE/01_Scripts/crypto_bot/logs/

# ---- PERSONAL DOCUMENTS (not for public repo) ----
05_PERSONAL/

# ---- AUDIO / LARGE PERSONAL MEDIA ----
*.m4a
*.mp3
*.wav

