#!/usr/bin/env python3
"""
intel -- Everlight Intel Center CLI
Single entry point for the resource database. SQLite-backed.

Usage:
  intel                          # open the master HTML report (default)
  intel dash                     # same -- explicit

  # Browse / search
  intel search <query>           # full-text search across name/domain/purpose
  intel cat <category>           # list resources in a category (substring match)
  intel agent <name>             # resources owned by an agent
  intel review                   # show the review queue (unverified rows)
  intel stats                    # category + agent breakdown

  # Live data (fetchable categories only)
  intel news                     # pull headlines from News & Journalism sources
  intel weather                  # pull from Weather & Disaster Intel sources
  intel space                    # pull from Space & Science sources
  intel finance                  # pull from Trading & Finance sources
  intel osint                    # pull from OSINT & Investigation sources
  intel health                   # pull from Health & Environment sources
  intel fetch <category-substr>  # pull from any fetchable category

  # Per-source pull (live)
  intel pull <domain>            # fetch ONE source -- RSS first, HTML scrape fallback. Caches results.
  intel pull-all <category>      # batch pull every source in a category (parallel)
  intel articles [query]         # search across cached articles (cross-source)
  intel show <domain>            # show stored use_case + setup + cached articles for a source

  # Activation (wires agents to their resources)
  intel manifest                 # generate per-agent source manifests
  intel wire                     # append Intel Center reference to all agent firmwares

  # Maintenance
  intel audit                    # grep workspace for usage of every resource
  intel audit-report             # show the most recent audit results
  intel audit-end-to-end         # full e2e: dashboard routes + OSINT API + article URLs + theme drift
  intel audit-end-to-end --theme-only   # quick theme drift scan only
  intel rebuild                  # re-run categorize-only (cached OCR)
  intel rebuild-full             # re-run OCR + categorize (35 min)
"""
