        print(f"  seller:    {meta.get('seller_name')} <{meta.get('seller_email')}>")
        print(f"  test_mode: {meta.get('test_mode', False)}")
        print()
        result = fire_step(key, "m1_intro")
        print(_json.dumps(result, indent=2))

    elif sub == "status":
        if len(args) < 2:
            print("usage: intel deal status <deal_key>"); return
        key = args[1]
        st = deal_status(key)
        print(f"=== deal {key} status ===")
        print(f"  events:     {st['event_count']}")
        print(f"  last_stage: {st.get('last_event_stage')}")
        print()
        print("--- timeline ---")
        for e in deal_history(key)[-15:]:
            amt = f"${e['amount_usd']:,}" if e['amount_usd'] else ""
            print(f"  [{e['id']:03d}] {e['ts'][:19]} {e['event']:18} {amt:>10} -- {(e['notes'] or '')[:80]}")

    elif sub == "verify":
        if len(args) < 2:
            print("usage: intel deal verify <deal_key>"); return
        key = args[1]
        # Global chain verify (the hash chain is across all deals; tamper-detect on
