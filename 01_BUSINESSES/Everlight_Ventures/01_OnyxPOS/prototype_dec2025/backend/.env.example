# Flask Environment
FLASK_ENV=production
SECRET_KEY=generate-with-python-secrets-module
JWT_SECRET_KEY=generate-with-python-secrets-module

# Database (Railway sets this automatically)
DATABASE_URL=postgresql://user:password@host:port/database

# Stripe
STRIPE_SECRET_KEY=sk_test_or_live_...
STRIPE_PUBLISHABLE_KEY=pk_test_or_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Email (optional - SendGrid)
SENDGRID_API_KEY=SG...
FROM_EMAIL=noreply@onyxpos.com

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# App URLs
APP_URL=https://your-app.railway.app
FRONTEND_URL=http://localhost:5173
